#!/bin/bash
# termfont — switch the monospace font of Alacritty and Emacs together, to try
# fonts one by one. Ubuntu Mono was the only face from ~2010 to Oct 2026.
#
#   termfont                 current font, size and mode
#   termfont list            all fonts (* = current, - = not installed)
#   termfont set KEY|NAME    switch to KEY or menu NAME (see `list`)
#   termfont names           menu names of the installed fonts (niri-screen-switch)
#   termfont next | prev     the next / previous installed font
#   termfont flip            back to the font before this one (A/B test)
#   termfont pick            rofi menu, every row drawn in its own font
#   termfont size NAME       small | middle | big | huge (the *-font scripts call this)
#   termfont match cols|pt   cols: scale each font to Ubuntu Mono's cell width, so
#                            the column count stays (default); pt: same point size
#   termfont note TEXT       write an opinion about the current font to the log
#   termfont log             show the log
#   termfont apply           write all outputs again from the state
#
# Outputs: ~/.config/alacritty/active-family.toml (family) and active-font.toml
# (size), which live_config_reload repaints at once; ~/.config/termfont/emacs.el,
# which Emacs loads at start, plus a live `emacsclient` call.
# `w95 on` still wins over all of this: its active-fontface.toml loads last.

set -euo pipefail

STATE="$HOME/.config/termfont"
ALA="$HOME/.config/alacritty"

# key | fontconfig family | advance width of "0" in em (measured with fontTools,
# Oct 2026) | short note | name in menus. The width gives the scale in `cols` mode: Ubuntu Mono
# is 0.5 em, so a 0.6 em font is drawn at 0.5/0.6 of the size.
FONTS=(
    "ubuntu|Ubuntu Mono|0.500|the 16-year default; narrow, short line|Ubuntu Mono"
    "ubuntu-sans|Ubuntu Sans Mono|0.560|Canonical's 2023 redesign of Ubuntu Mono|Ubuntu Sans Mono"
    "iosevka|IosevkaTerm Nerd Font Mono|0.500|narrow like Ubuntu Mono, larger x-height|Iosevka Term"
    "adwaita|Adwaita Mono|0.600|GNOME's Iosevka build, normal width|Adwaita Mono"
    "jetbrains|JetBrainsMono Nerd Font Mono|0.600|tall x-height, plain shapes|JetBrains Mono"
    "fira|FiraCode Nerd Font Mono|0.615|humanist, from Fira Sans|Fira Code"
    "cascadia|CaskaydiaMono Nerd Font Mono|0.586|Windows Terminal's face|Cascadia Mono"
    "plex|BlexMono Nerd Font Mono|0.600|IBM Plex Mono, slab serifs|IBM Plex Mono"
    "hack|Hack Nerd Font Mono|0.602|DejaVu Sans Mono, re-hinted|Hack"
    "commit|CommitMono Nerd Font Mono|0.600|neutral, very regular|Commit Mono"
    "monaspace|Monaspace Neon|0.620|GitHub's, wide; Argon/Xenon/Radon/Krypton too|Monaspace Neon"
    "victor|VictorMono Nerd Font Mono|0.545|narrow, cursive italics|Victor Mono"
    "geist|GeistMono Nerd Font Mono|0.600|Vercel's, geometric|Geist Mono"
    "0xproto|0xProto Nerd Font Mono|0.620|made for small sizes, wide|0xProto"
    "maple|Maple Mono NF|0.600|rounded, cursive italics|Maple Mono"
    "googlesans|GoogleSansCode Nerd Font Mono|0.600|Google's 2024 code face (Android Studio)|Google Sans Code"
)

# size name -> Alacritty points, Emacs height (1/10 pt). The pairs are the ones
# the *-font scripts and the Emacs *-font defuns always used.
declare -A ALA_SIZE=([small]=12 [middle]=16 [big]=24 [huge]=32)
declare -A EMACS_HEIGHT=([small]=120 [middle]=135 [big]=180 [huge]=220)

mkdir -p "$STATE"

read_state() { cat "$STATE/$1" 2>/dev/null || printf '%s' "$2"; }

field() { # field KEY N
    local e
    for e in "${FONTS[@]}"; do
        [[ ${e%%|*} == "$1" ]] && { cut -d'|' -f"$2" <<<"$e"; return 0; }
    done
    return 1
}

installed() { fc-list -q "$(field "$1" 2)"; }

current() { read_state font ubuntu; }

say() {
    printf '%s — %s\n' "$1" "$2"
    command -v notify-send >/dev/null && notify-send -a termfont "$1" "$2" 2>/dev/null || true
}

log() { printf '%s %s %s\n' "$(date '+%F %H:%M')" "$(hostname -s)" "$*" >>"$STATE/log"; }

scale() { # the size factor for the current font
    if [[ $(read_state match cols) == pt ]]; then
        echo 1
    else
        awk -v a="$(field "$(current)" 3)" 'BEGIN { printf "%.4f", 0.5 / a }'
    fi
}

apply() {
    local key family size scale pt sexp
    key=$(current)
    family=$(field "$key" 2) || { echo "termfont: unknown font '$key' in $STATE/font" >&2; exit 1; }
    size=$(read_state size small)
    scale=$(scale)
    pt=$(awk -v s="${ALA_SIZE[$size]}" -v f="$scale" 'BEGIN { printf "%.1f", s * f }')

    # Family only: fallback-fontface.toml holds the styles (Regular/Bold/…).
    {
        printf '# generated by `termfont` (%s) — do not edit, run `termfont set`\n' "$key"
        for slot in normal bold italic bold_italic; do
            printf '[font.%s]\nfamily = "%s"\n\n' "$slot" "$family"
        done
    } >"$ALA/active-family.toml"
    printf '[font]\nsize = %s\n' "$pt" >"$ALA/active-font.toml"
    # The menu name, for the bar's displays panel (it lights the current face).
    printf '%s\n' "$(field "$key" 5)" >"$STATE/name"

    # Emacs gets the family and the scale; its own small/middle/big/huge-font
    # keep their heights and multiply by the scale (see tg/font-apply in elisp.el).
    sexp=$(printf '(setq tg/font-family "%s" tg/font-scale %s tg/font-base-height %s)' \
        "$family" "$scale" "${EMACS_HEIGHT[$size]}")
    printf ';; generated by `termfont` — do not edit\n%s\n' "$sexp" >"$STATE/emacs.el"
    if command -v emacsclient >/dev/null && emacsclient -e t >/dev/null 2>&1; then
        emacsclient -e "(progn $sexp (tg/font-apply))" >/dev/null || true
    fi
}

key_of() { # key or menu name -> key
    local e
    for e in "${FONTS[@]}"; do
        [[ ${e%%|*} == "$1" || ${e##*|} == "$1" ]] && { printf '%s\n' "${e%%|*}"; return 0; }
    done
    printf '%s\n' "$1"
}

set_font() {
    local key old
    key=$(key_of "$1")
    field "$key" 1 >/dev/null || { echo "termfont: no font '$key' (see: termfont list)" >&2; exit 2; }
    installed "$key" || {
        say "termfont" "$(field "$key" 2) is not installed on $(hostname -s)"
        exit 1
    }
    old=$(current)
    [[ $old != "$key" ]] && printf '%s\n' "$old" >"$STATE/prev"
    printf '%s\n' "$key" >"$STATE/font"
    apply
    log "set $key"
    say "Font: $(field "$key" 5)" "$(read_state size small), $(read_state match cols) mode — $(field "$key" 4)"
}

step() { # step +1 | -1, over installed fonts only
    local keys=() e i n cur
    for e in "${FONTS[@]}"; do installed "${e%%|*}" && keys+=("${e%%|*}"); done
    n=${#keys[@]}
    cur=$(current)
    for i in "${!keys[@]}"; do [[ ${keys[$i]} == "$cur" ]] && break; done
    set_font "${keys[$(((i + $1 + n) % n))]}"
}

pick() {
    local rows=() keys=() e key cur idx
    cur=$(current)
    for e in "${FONTS[@]}"; do
        key=${e%%|*}
        installed "$key" || continue
        keys+=("$key")
        rows+=("$(printf '<span font_family="%s">%s %-12s 0O Il1| {[()]} -> != ~ @  %s</span>' \
            "$(field "$key" 2)" "$([[ $key == "$cur" ]] && echo '*' || echo ' ')" "$key" "$(field "$key" 4)")")
    done
    idx=$(printf '%s\n' "${rows[@]}" | rofi -dmenu -i -markup-rows -format i \
        -lines ${#rows[@]} -font "Ubuntu 18" -p "font") || exit 0
    [[ -n $idx ]] && set_font "${keys[$idx]}"
}

case ${1-} in
    "")
        printf '%s — %s (%s, %s mode, x%s)\n' "$(current)" "$(field "$(current)" 2)" \
            "$(read_state size small)" "$(read_state match cols)" "$(scale)"
        ;;
    list)
        cur=$(current)
        for e in "${FONTS[@]}"; do
            key=${e%%|*}
            mark=' '
            [[ $key == "$cur" ]] && mark='*'
            installed "$key" || mark='-'
            printf '%s %-12s %-30s %s\n' "$mark" "$key" "$(field "$key" 2)" "$(field "$key" 4)"
        done
        ;;
    set) set_font "${2:?usage: termfont set KEY|NAME}" ;;
    names)
        for e in "${FONTS[@]}"; do installed "${e%%|*}" && printf '%s\n' "${e##*|}"; done
        ;;
    next) step 1 ;;
    prev) step -1 ;;
    flip)
        prev=$(read_state prev "")
        [[ -n $prev ]] || { say "termfont" "no previous font yet"; exit 0; }
        set_font "$prev"
        ;;
    pick) pick ;;
    size)
        [[ -n ${ALA_SIZE[${2-}]-} ]] || { echo "usage: termfont size small|middle|big|huge" >&2; exit 2; }
        printf '%s\n' "$2" >"$STATE/size"
        apply
        ;;
    match)
        [[ ${2-} == cols || ${2-} == pt ]] || { echo "usage: termfont match cols|pt" >&2; exit 2; }
        printf '%s\n' "$2" >"$STATE/match"
        apply
        say "termfont" "match mode: $2"
        ;;
    note)
        shift
        [[ $# -gt 0 ]] || { echo "usage: termfont note TEXT" >&2; exit 2; }
        log "note $(current): $*"
        ;;
    log) cat "$STATE/log" 2>/dev/null || true ;;
    apply) apply ;;
    -h | --help | help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0" ;;
    *) echo "termfont: unknown command '$1' (see: termfont help)" >&2; exit 2 ;;
esac
