#!/bin/bash
set -euo pipefail

usage() {
    echo "usage: theme <light|dark> <gruvbox|selenized>" >&2
    exit 2
}

[[ $# -eq 2 ]] || usage
mode=$1
palette=$2

case $mode in light | dark) ;; *) usage ;; esac
case $palette in gruvbox | selenized) ;; *) usage ;; esac

case $palette:$mode in
    gruvbox:light) emacs_theme=doom-gruvbox-light ;;
    gruvbox:dark) emacs_theme=doom-gruvbox ;;
    selenized:light) emacs_theme=doom-solarized-light ;;
    selenized:dark) emacs_theme=doom-solarized-dark ;;
esac

# Load the semantic UI palette (bg_main, accent, urgent, …) from the i3 colors
# file so dunst/rofi/tmux/fzf all share one source of truth.
declare -A COL
i3_palette="$HOME/.config/i3/colors.d/$palette-$mode.conf"
if [[ -f $i3_palette ]]; then
    while read -r name hex; do COL[$name]=$hex; done < <(
        awk '/^set \$/{n=$2; sub(/^\$/,"",n); print n, $3}' "$i3_palette")
fi
# col <name> [fallback] — semantic color lookup
col() { printf '%s' "${COL[$1]:-${2:-#000000}}"; }

# Named themes for apps that ship their own palettes (not hex-driven)
case $palette:$mode in
    gruvbox:dark) bat_theme="gruvbox-dark";       btop_theme="gruvbox_dark" ;;
    gruvbox:light) bat_theme="gruvbox-light";      btop_theme="gruvbox_light" ;;
    selenized:dark) bat_theme="Solarized (dark)";   btop_theme="solarized_dark" ;;
    selenized:light) bat_theme="Solarized (light)";  btop_theme="solarized_light" ;;
esac

uv run ~/dotfiles/alacritty/combiner.py "$mode" "$palette"

if command -v gsettings >/dev/null; then
    gsettings set org.gnome.desktop.interface color-scheme "prefer-$mode"
fi

case $mode in
    dark)
        gtk_name=Adapta-Nokto-Eta-Maia
        prefer_dark_ini=true
        prefer_dark_xs=1
        ;;
    light)
        gtk_name=Adapta-Eta-Maia
        prefer_dark_ini=false
        prefer_dark_xs=0
        ;;
esac

gtk3_ini=$HOME/.config/gtk-3.0/settings.ini
gtkrc2=$HOME/.gtkrc-2.0
if [[ -f $gtk3_ini ]]; then
    sed -i -E \
        -e "s|^gtk-theme-name=.*|gtk-theme-name=$gtk_name|" \
        -e "s|^gtk-application-prefer-dark-theme=.*|gtk-application-prefer-dark-theme=$prefer_dark_ini|" \
        "$gtk3_ini"
fi
if [[ -f $gtkrc2 ]]; then
    sed -i -E "s|^gtk-theme-name=.*|gtk-theme-name=\"$gtk_name\"|" "$gtkrc2"
fi

xs_conf=$HOME/.config/xsettingsd/xsettingsd.conf
if [[ -f $xs_conf ]]; then
    sed -i -E \
        -e "s|^Net/ThemeName .*|Net/ThemeName \"$gtk_name\"|" \
        -e "s|^Gtk/ApplicationPreferDarkTheme .*|Gtk/ApplicationPreferDarkTheme $prefer_dark_xs|" \
        "$xs_conf"
    pkill -HUP -x xsettingsd || true
fi

claude_settings=$HOME/.claude/settings.json
if [[ -f $claude_settings ]]; then
    tmp=$(mktemp)
    jq --arg t "$mode" '.theme = $t' "$claude_settings" >"$tmp" && mv "$tmp" "$claude_settings"
fi

wallpaper_dir=$HOME/Pictures/wallpapers
wallpaper=""
# Prefer numbered variants ($palette-$mode-1.png, -2, …) and pick one at random
# so each theme switch / login can rotate between several wallpapers. The choice
# is baked into ~/.fehbg, so an i3 reload replays the same pick (no re-roll on reload).
variants=()
for ext in png jpg jpeg; do
    for cand in "$wallpaper_dir/$palette-$mode"-*."$ext"; do
        [[ -f $cand ]] && variants+=("$cand")
    done
done
if (( ${#variants[@]} )); then
    wallpaper="${variants[RANDOM % ${#variants[@]}]}"
fi
# fall back to the legacy single file $palette-$mode.<ext>
if [[ -z $wallpaper ]]; then
    for ext in png jpg jpeg; do
        cand="$wallpaper_dir/$palette-$mode.$ext"
        if [[ -f $cand ]]; then wallpaper=$cand; break; fi
    done
fi
# fall back to a per-mode wallpaper, then the existing default
if [[ -z $wallpaper ]]; then
    for ext in png jpg jpeg; do
        cand="$wallpaper_dir/$mode.$ext"
        if [[ -f $cand ]]; then wallpaper=$cand; break; fi
    done
fi
if [[ -z $wallpaper && -f $HOME/Pictures/legartis-escher.png ]]; then
    wallpaper=$HOME/Pictures/legartis-escher.png
fi
if [[ -n $wallpaper ]] && command -v feh >/dev/null; then
    feh --no-fehbg --bg-scale "$wallpaper"
    printf '#!/bin/sh\nfeh --no-fehbg --bg-scale %q\n' "$wallpaper" >"$HOME/.fehbg"
    chmod +x "$HOME/.fehbg"
fi

i3_colors_dir=$HOME/.config/i3/colors.d
if [[ -d $i3_colors_dir ]]; then
    ln -sf "colors.d/$palette-$mode.conf" "$HOME/.config/i3/active-palette.conf"
    # THEME_NO_I3_RELOAD is set by theme-restore (run from i3 autostart) to
    # avoid a reload loop — the palette symlink is already correct at login.
    if [[ -z ${THEME_NO_I3_RELOAD:-} ]] && i3-msg -t get_version >/dev/null 2>&1; then
        i3-msg reload >/dev/null
    fi
fi

# ---- dunst: recolour notification popups, then live-reload ----
dunstrc=$HOME/.config/dunst/dunstrc
if [[ -f $dunstrc ]] && [[ ${#COL[@]} -gt 0 ]]; then
    tmp=$(mktemp)
    awk -v frame="$(col accent)" \
        -v lowbg="$(col bg_main)"  -v lowfg="$(col fg_dim)" \
        -v normbg="$(col bg_main)" -v normfg="$(col fg_main)" \
        -v critbg="$(col urgent)"  -v critfg="$(col urgent_fg)" '
        /^\[/ { sec=$0 }
        {
            if (sec=="[global]" && $0 ~ /^[[:space:]]*frame_color[[:space:]]*=/) {
                print "    frame_color = \"" frame "\""; next }
            if (sec=="[urgency_low]") {
                if ($0 ~ /^[[:space:]]*background[[:space:]]*=/) { print "    background = \"" lowbg "\""; next }
                if ($0 ~ /^[[:space:]]*foreground[[:space:]]*=/) { print "    foreground = \"" lowfg "\""; next } }
            if (sec=="[urgency_normal]") {
                if ($0 ~ /^[[:space:]]*background[[:space:]]*=/) { print "    background = \"" normbg "\""; next }
                if ($0 ~ /^[[:space:]]*foreground[[:space:]]*=/) { print "    foreground = \"" normfg "\""; next } }
            if (sec=="[urgency_critical]") {
                if ($0 ~ /^[[:space:]]*background[[:space:]]*=/) { print "    background = \"" critbg "\""; next }
                if ($0 ~ /^[[:space:]]*foreground[[:space:]]*=/) { print "    foreground = \"" critfg "\""; next } }
            print
        }' "$dunstrc" >"$tmp" && mv "$tmp" "$dunstrc"
    command -v dunstctl >/dev/null && dunstctl reload 2>/dev/null || true
fi

# ---- rofi: regenerate the imported colour palette ----
rofi_colors=$HOME/.config/rofi/active-colors.rasi
if [[ -d $HOME/.config/rofi ]] && [[ ${#COL[@]} -gt 0 ]]; then
    cat >"$rofi_colors" <<EOF
/* generated by \`theme\` — do not edit; reflects $palette $mode */
* {
    base03:  $(col bg_main);
    base02:  $(col bg_alt);
    base01:  $(col sep);
    base00:  $(col fg_dim);
    base0:   $(col fg_main);
    base1:   $(col title_fg);
    base2:   $(col bg_alt);
    base3:   $(col title_fg);
    yellow:  $(col warn);
    orange:  $(col warn);
    red:     $(col urgent);
    magenta: $(col indicator);
    violet:  $(col indicator);
    blue:    $(col info);
    cyan:    $(col info);
    green:   $(col accent);
}
EOF
fi

# ---- tmux: statusline colours, live-reloaded into running servers ----
tmux_colors=$HOME/.config/tmux/colors.conf
if command -v tmux >/dev/null && [[ ${#COL[@]} -gt 0 ]]; then
    mkdir -p "$HOME/.config/tmux"
    cat >"$tmux_colors" <<EOF
# generated by \`theme\` — reflects $palette $mode
set -g status-style "bg=$(col bg_main),fg=$(col fg_main)"
set -g window-status-current-style "bg=$(col accent),fg=$(col accent_fg)"
set -g window-status-style "bg=$(col bg_main),fg=$(col fg_dim)"
set -g pane-active-border-style "fg=$(col accent)"
set -g pane-border-style "fg=$(col sep)"
set -g message-style "bg=$(col bg_alt),fg=$(col title_fg)"
set -g mode-style "bg=$(col accent),fg=$(col accent_fg)"
EOF
    # source into every running server
    if tmux ls >/dev/null 2>&1; then
        tmux source-file "$tmux_colors" 2>/dev/null || true
    fi
fi

# ---- bat + fzf: export themes/colours for new shells ----
theme_env=$HOME/.config/theme/env.sh
mkdir -p "$HOME/.config/theme"
{
    echo "# generated by \`theme\` — reflects $palette $mode"
    printf 'export BAT_THEME=%q\n' "$bat_theme"
    if [[ ${#COL[@]} -gt 0 ]]; then
        printf 'export FZF_DEFAULT_OPTS="--color=bg+:%s,bg:%s,spinner:%s,hl:%s,fg:%s,header:%s,info:%s,pointer:%s,marker:%s,fg+:%s,prompt:%s,hl+:%s"\n' \
            "$(col bg_alt)" "$(col bg_main)" "$(col accent)" "$(col info)" \
            "$(col fg_main)" "$(col info)" "$(col fg_dim)" "$(col accent)" \
            "$(col warn)" "$(col title_fg)" "$(col accent)" "$(col info)"
    fi
} >"$theme_env"

# ---- btop: switch its colour theme (picked up on next launch) ----
btop_conf=$HOME/.config/btop/btop.conf
if command -v btop >/dev/null && [[ -n ${btop_theme:-} ]]; then
    mkdir -p "$HOME/.config/btop"
    if [[ -f $btop_conf ]] && grep -q '^color_theme' "$btop_conf"; then
        sed -i -E "s|^color_theme.*|color_theme = \"$btop_theme\"|" "$btop_conf"
    else
        printf 'color_theme = "%s"\n' "$btop_theme" >>"$btop_conf"
    fi
fi

# ---- persist the choice so it survives logout (see theme-restore) ----
printf '%s %s\n' "$mode" "$palette" >"$HOME/.config/theme/state"

# ---- desktop notification ----
command -v notify-send >/dev/null && \
    notify-send -t 2000 -a theme "Theme switched" "$palette $mode" 2>/dev/null || true

if emacsclient -e t >/dev/null 2>&1; then
    emacsclient -n -e "(progn (mapc #'disable-theme custom-enabled-themes)(load-theme '$emacs_theme t))" >/dev/null
fi
