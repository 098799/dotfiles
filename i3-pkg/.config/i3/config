# Win95 System Monitor: a quake-style panel that drops in from the top edge.
# Press once to bring it in, press again to send it away — the process stays
# resident and hidden in between, so every press after the first is instant.
# Everything the i3blocks status bar used to display lives on that one page,
# and everything it could be clicked for can be done from there.
bindsym $mod+s exec --no-startup-id w95-sysmon
# Start it hidden at login so its charts have history before the first time
# you look. `exec`, never `exec_always`: a second invocation is a keypress
# being handed to the resident instance, so a reload would toggle the panel
# open every time you pressed $mod+Shift+c.
exec --no-startup-id w95-sysmon --hidden
# cmon monitor TUI (terminal closes when cmon exits). Moved off $mod+s, which
# the System Monitor now owns.
bindsym $mod+Shift+s exec env PATH=/home/tgrining/bin:/home/tgrining/.local/bin:$PATH alacritty -e /home/tgrining/bin/cmon

