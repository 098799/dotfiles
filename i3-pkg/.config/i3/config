# Windows 95 keybindings, switched on and off by `w95-switch` (symlink into
# win95-keys.conf or no-keys.conf). An include can only *add* bindings — i3
# rejects a duplicate keybinding as a config error rather than overriding it —
# so everything in there is chosen not to collide with the bindings above.
include ~/.config/i3/active-keys.conf

# Keep the Win95 taskbar/wallpaper in sync with ~/.config/w95/wm on every
# start, reload and restart. No-op (and idempotent) in the stock desktop.
exec_always --no-startup-id w95-autobar

# Window chrome (border style + title font), swapped by `w95 on` / `w95 off`
# between chrome.d/stock.conf and chrome.d/win95.conf. This include has to
# come LAST: i3-95 can only draw a Win95 caption where i3 draws a decoration,
# so Windows 95 mode needs `border normal`, which must beat the
# `default_border pixel 10` set above.
include ~/.config/i3/active-chrome.conf

# The System Monitor ($mod+s). Both chrome files above carry a
# `for_window [class=".*"] border …` catch-all to reborder windows that are
# already on screen when the theme switches, and `for_window` rules are applied
# in the order they were declared — so the only place a per-window border can
# survive the switch is *after* that include. Hence: after the last line of the
# file, on purpose.
#
# The drop-down variant is a bare panel, not a window: no decoration to argue
# with, and sticky so it follows you rather than living on one workspace. In
# `window` mode (Options ▸ Display as) the instance name differs, so it keeps
# whatever caption the current chrome draws.
for_window [class="W95sysmon"] floating enable
for_window [instance="w95-sysmon-drop"] border none, sticky enable
