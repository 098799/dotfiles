# Re-apply the last-saved theme (wallpaper + all app colors) on login.
# `exec` (not exec_always) so it runs once at startup, never on reload.
exec --no-startup-id $HOME/bin/theme-restore
# Re-stretch the wallpaper to the current monitor layout on every reload.
# `theme` writes ~/.fehbg (feh --bg-scale <current wallpaper>); replaying it
# only touches the X root, so it's safe in exec_always (no reload loop) and
# restores the pre-theme-system "mod+Shift+c re-stretches" behavior.
exec_always --no-startup-id sh -c '[ -x "$HOME/.fehbg" ] && "$HOME/.fehbg"'

