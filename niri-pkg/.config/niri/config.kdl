// niri — the scrolling-tiling twin of ~/.config/i3/config.
//
// Every binding is the i3 one, moved over where niri has the same verb. What
// did not move over is listed in README.md, under "Not ported from i3".
//
// The mental model, i3 → niri:
//   i3 "split v"           = a COLUMN: stack windows on top of each other
//   i3 "split h"           = the workspace itself, an endless strip of columns
//   i3 "layout tabbed"     = tabbed display of one column
//   i3 "fullscreen"        = fullscreen-window; maximize-column is the softer one
//   i3 "workspace N"       = a named workspace — niri keeps them per output
// niri reloads on every save of any of these files; there is no reload keybind.
//
// This file is the entry point. Read README.md in this directory first.
// The rest of the config is split by topic and included at the bottom:
//   layout.kdl       gaps, column widths, borders, tab strip, shadow
//   rules.kdl        per-app window rules (float, no border, ...)
//   binds.kdl        every key binding
//   startup.kdl      programs started at login
//   environment.kdl  env vars for started programs (mostly a scrub list)
// A file with an error is refused WHOLE and the last good config stays live,
// so run `niri validate` after an edit.

input {
    keyboard {
        xkb {
            // us only. pl went on 8 Oct 2026: its AltGr letters need right Alt,
            // and kanata (~/.config/kanata) makes right Alt the Esc/NUM thumb.
            // F14's switch-layout (binds.kdl) has nothing to switch to now.
            layout "us"
        }
        numlock
        repeat-delay 300
        repeat-rate 40
    }
    touchpad {
        tap
        natural-scroll
    }
    // i3: focus_follows_mouse no
    focus-follows-mouse max-scroll-amount="0%"
    warp-mouse-to-focus
}

// Outputs are found with `niri msg outputs`; Wayland names differ from xrandr's.
// output "DP-1" {
//     mode "2560x1440@144"
// }

// No `workspace "name"` lines: niri keeps a workspace named here for ever, empty or
// not. The i3 names (c 0 1 2 3 4 5 w s 6 7 8 p 9 10) are given at runtime by
// niri-ws (~/bin/niri-ws: the binds call it, its daemon runs from startup.kdl), so
// a workspace exists only while it is used, as in i3. The order is in that script.

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

animations {
    slowdown 0.8
}

// ---- Overview -------------------------------------------------------------
// niri's Exposé. Two ways in, both already live:
//   Mod+Tab        toggle-overview (binds.kdl)
//   top-left hot corner, GNOME-style, ON BY DEFAULT
// i3 had no equivalent, so nothing was ported here — this is niri's own answer
// to "what do I have open", and it is why the bar does not need to answer it.
//
// NOTE: waybar is `position: top` with niri/workspaces first, so its leftmost
// module sits in the same corner that arms the hot corner. If clicking a
// workspace pill keeps flinging you into the Overview, that is the collision.
// Fix by disabling the corner (Mod+Tab still works):
//
//   gestures {
//       hot-corners {
//           off
//       }
//   }
//
// Appearance knobs, if the default zoom reads too tight:
//   overview { zoom 0.5; backdrop-color "#1d2021"; }
// Left unset on purpose: backdrop-color is a fixed hex, and the dark-gruv /
// light-gruv / dark-sele / light-sele switches would not follow it.

include "layout.kdl"
include "rules.kdl"
include "binds.kdl"
include "startup.kdl"
include "environment.kdl"
// Mod+C's hot-bottom indicator (i3's split v colour on the bottom edge).
// niri-hot-bottom writes this file at runtime, so it is not in the repo:
// ~/dotfiles is a Syncthing folder and the other host would get the state
// too. niri cannot expand $XDG_RUNTIME_DIR here, hence the fixed uid 1000.
// optional=true: the file does not exist until the daemon starts.
include optional=true "/run/user/1000/niri-hot-bottom.kdl"
