// Two bars: one for the laptop screen, one for every other screen. They show
// the same blocks in the same order. The module definitions are in
// modules.jsonc, which both bars include; a bar overrides single keys only.
//
// Why the laptop gets its own bar: eDP-1 is 1920x1200 at scale 1.25, so the bar
// has 1536 logical px. The full blocks need ~2070, and waybar does not shorten
// anything: it cuts off the right end, so the clock, battery, tray and six
// more blocks were simply not there. i3bar solved this by itself: when the bar
// overflowed it showed every block's short_text (the second line an i3blocks
// script prints). The laptop bar does the same by choice: "{alt}" is that short
// text (see ~/bin/i3blocks-waybar), and the native modules get shorter formats.
// The full text is in every block's tooltip.
//
// Nerd Font icons here are raw private-use characters (U+F0000 and up). Some
// editors and tools drop them silently and leave a plain space. After an edit,
// check they survived:
//     grep -oP '[\x{F0000}-\x{FFFFD}]' ~/.config/waybar/config.jsonc | wc -l   # expect 3
[
{
    "name": "main",
    "output": ["!eDP-1", "*"],
    "include": ["~/.config/waybar/modules.jsonc"],
    "layer": "top",
    "position": "top",
    // One terminal line of UbuntuMono 12 plus a little air. ~/bin/barmenu
    // opens menus just under it (BAR_HEIGHT there).
    "height": 22,
    "spacing": 0,
    // No window title: i3bar had none, and with every i3 block on the right there
    // is no room left for one. The focused window has the accent border, and the
    // custom/cols tooltip lists every window on the workspace.
    "modules-left": ["niri/workspaces", "custom/cols"],
    "modules-center": [],
    "modules-right": [
        "custom/claude", "cpu", "temperature", "memory", "memory#swap", "custom/disk",
        "custom/updates", "custom/network", "custom/vpn", "custom/bluetooth",
        "custom/bt-headphones", "custom/bt-keyboard",
        "pulseaudio", "pulseaudio#mic",
        "custom/cpu-boost", "custom/cpu-cap", "custom/power-profile",
        "custom/battery", "custom/screenshot", "custom/uptime", "tray", "clock"
    ]
},
{
    "name": "laptop",
    "output": "eDP-1",
    "include": ["~/.config/waybar/modules.jsonc"],
    "layer": "top",
    "position": "top",
    // Same as the main bar, so ~/bin/barmenu needs one number only.
    "height": 22,
    "spacing": 0,
    "modules-left": ["niri/workspaces", "custom/cols"],
    "modules-center": [],
    "modules-right": [
        "custom/claude", "cpu", "temperature", "memory", "memory#swap", "custom/disk",
        "custom/updates", "custom/network", "custom/vpn", "custom/bluetooth",
        "custom/bt-headphones", "custom/bt-keyboard",
        "pulseaudio", "pulseaudio#mic",
        "custom/cpu-boost", "custom/cpu-cap", "custom/power-profile",
        "custom/battery", "custom/screenshot", "custom/uptime", "tray", "clock"
    ],
    // short_text. Claude drops the reset timers; the device and network blocks
    // drop their names and keep the icon, whose colour still says on / off.
    "custom/claude":        { "format": "{alt}" },
    "custom/disk":          { "format": "{alt}" },
    "custom/network":       { "format": "{alt}" },
    "custom/vpn":           { "format": "{alt}" },
    "custom/bluetooth":     { "format": "{alt}" },
    "custom/bt-headphones": { "format": "{alt}" },
    "custom/bt-keyboard":   { "format": "{alt}" },
    // Percentages, not "40.1G/86.1G". The tooltip has the other number.
    "memory":      { "format": "󰘚 {percentage}%", "tooltip-format": "{used:0.1f}G of {total:0.1f}G used\nleft: htop by memory · right: free -h" },
    "memory#swap": { "format": "󰓡 {swapPercentage}%", "tooltip-format": "swap {swapUsed:0.1f}G of {swapTotal:0.1f}G used\nleft: htop by memory · right: swapon --show" },
    // The red icon says muted; the word is not needed.
    "pulseaudio":  { "format-muted": "󰖁" }
}
]
