// The i3bar/i3blocks twin for niri.
//
// Every block runs the SAME ~/scripts/*.sh as ~/.config/i3blocks/config, through
// ~/bin/i3blocks-waybar, so both bars show the same icons, text and colours and
// keep the same click menus. Order, intervals and signal numbers follow that
// file. Only four modules are native, each for a reason:
//   pulseaudio, pulseaudio#mic  follow PulseAudio events, so no key bind has to
//                               signal the bar (the i3 binds had to);
//   tray, clock                 no script can do these.
//
// Nerd Font icons here are raw private-use characters (U+F0000 and up). Some
// editors and tools drop them silently and leave a plain space — that is how
// every native icon went missing once. After an edit, check they survived:
//     grep -oP '[\x{F0000}-\x{FFFFD}]' ~/.config/waybar/config.jsonc | wc -l   # expect 6
{
    "layer": "top",
    "position": "top",
    // i3bar's height at this font. ~/bin/i3blocks-waybar opens menus just under it.
    "height": 27,
    "spacing": 0,
    // No window title: i3bar had none, and with every i3 block on the right there
    // is no room left for one. The focused window has the accent border, and the
    // custom/cols tooltip lists every window on the workspace.
    "modules-left": ["niri/workspaces", "custom/cols"],
    "modules-center": [],
    "modules-right": [
        "custom/claude", "custom/cpu", "custom/temp", "custom/memory", "custom/disk",
        "custom/updates", "custom/network", "custom/vpn", "custom/bluetooth",
        "custom/bt-headphones", "custom/bt-keyboard",
        "pulseaudio", "pulseaudio#mic",
        "custom/cpu-boost", "custom/cpu-cap", "custom/power-profile",
        "custom/battery", "custom/screenshot", "custom/uptime", "tray", "clock"
    ],
    "niri/workspaces": {
        "format": "{value}",
        "current-only": false
    },
    // Scroll-strip position: "3/7" means focused column 3 of 7 on this workspace,
    // with arrows for however many are hidden off-screen left/right. Blank when a
    // workspace has one column or none, since nothing can be hidden then.
    // Event-driven off `niri msg -j event-stream`, so no polling interval.
    "custom/cols": {
        "exec": "~/bin/niri-colcount",
        "return-type": "json",
        "tooltip": true
    },

    // ---- i3blocks blocks ----------------------------------------------------
    // exec reads the block; on-click / on-click-right pass the button as
    // $BLOCK_BUTTON, as i3blocks did. --signal N redraws the block after a click
    // (`pkill -RTMIN+N waybar` does the same by hand). --hint is the hover text.
    "custom/claude": {
        "exec": "~/bin/i3blocks-waybar --hint 'right: switch account' ~/scripts/claude-usage.sh",
        "return-type": "json", "interval": 60, "signal": 15,
        "on-click-right": "~/bin/i3blocks-waybar --signal 15 ~/scripts/claude-usage.sh 3"
    },
    "custom/cpu": {
        "exec": "~/bin/i3blocks-waybar --hint 'left: htop · right: htop by CPU' ~/scripts/cpu.sh",
        "return-type": "json", "interval": 5,
        "on-click": "~/bin/i3blocks-waybar ~/scripts/cpu.sh 1",
        "on-click-right": "~/bin/i3blocks-waybar ~/scripts/cpu.sh 3"
    },
    "custom/temp": {
        "exec": "~/bin/i3blocks-waybar ~/scripts/temp.sh",
        "return-type": "json", "interval": 5
    },
    "custom/memory": {
        "exec": "~/bin/i3blocks-waybar --hint 'left: htop by memory · right: free -h' ~/scripts/memory.sh",
        "return-type": "json", "interval": 10,
        "on-click": "~/bin/i3blocks-waybar ~/scripts/memory.sh 1",
        "on-click-right": "~/bin/i3blocks-waybar ~/scripts/memory.sh 3"
    },
    "custom/disk": {
        "exec": "~/bin/i3blocks-waybar --hint 'left: biggest dirs (sudo du) · right: df -h' ~/scripts/disk.sh",
        "return-type": "json", "interval": 60,
        "on-click": "~/bin/i3blocks-waybar ~/scripts/disk.sh 1",
        "on-click-right": "~/bin/i3blocks-waybar ~/scripts/disk.sh 3"
    },
    "custom/updates": {
        "exec": "~/bin/i3blocks-waybar --timeout 120 --hint 'left: re-check · right: pacman -Syu' ~/scripts/updates.sh",
        "return-type": "json", "interval": 3600, "signal": 17,
        "on-click": "~/bin/i3blocks-waybar --signal 17 ~/scripts/updates.sh 1",
        "on-click-right": "~/bin/i3blocks-waybar --signal 17 ~/scripts/updates.sh 3"
    },
    "custom/network": {
        "exec": "~/bin/i3blocks-waybar --hint 'right: rescan / link rates / reconnect / reset adapter / nmtui / speedtest' ~/scripts/network.sh",
        "return-type": "json", "interval": 10, "signal": 19,
        "on-click-right": "~/bin/i3blocks-waybar --signal 19 ~/scripts/network.sh 3"
    },
    "custom/vpn": {
        "exec": "~/bin/i3blocks-waybar --hint 'right: wg_1 / wg_2 / off' ~/scripts/vpn.sh",
        "return-type": "json", "interval": 10, "signal": 18,
        "on-click-right": "~/bin/i3blocks-waybar --signal 18 ~/scripts/vpn.sh 3"
    },
    "custom/bluetooth": {
        "exec": "~/bin/i3blocks-waybar --hint 'right: bluetoothctl / power / nuke_bt / restart logid' ~/scripts/bluetooth.sh",
        "return-type": "json", "interval": 5, "signal": 20,
        "on-click-right": "~/bin/i3blocks-waybar --signal 20 ~/scripts/bluetooth.sh 3"
    },
    "custom/bt-headphones": {
        "exec": "~/bin/i3blocks-waybar --hint 'click: connect / disconnect' ~/scripts/bt-headphones.sh",
        "return-type": "json", "interval": 5, "signal": 21,
        "on-click": "~/bin/i3blocks-waybar --signal 21 ~/scripts/bt-headphones.sh 1",
        "on-click-right": "~/bin/i3blocks-waybar --signal 21 ~/scripts/bt-headphones.sh 3"
    },
    "custom/bt-keyboard": {
        "exec": "~/bin/i3blocks-waybar --hint 'click: connect / disconnect' ~/scripts/bt-keyboard.sh",
        "return-type": "json", "interval": 5, "signal": 22,
        "on-click": "~/bin/i3blocks-waybar --signal 22 ~/scripts/bt-keyboard.sh 1",
        "on-click-right": "~/bin/i3blocks-waybar --signal 22 ~/scripts/bt-keyboard.sh 3"
    },
    "custom/cpu-boost": {
        "exec": "~/bin/i3blocks-waybar --hint 'click: toggle turbo boost' ~/scripts/cpu-boost.sh",
        "return-type": "json", "interval": 30, "signal": 13,
        "on-click": "~/bin/i3blocks-waybar --signal 13 ~/scripts/cpu-boost.sh 1"
    },
    "custom/cpu-cap": {
        "exec": "~/bin/i3blocks-waybar --hint 'left: pick a CPU cap · right: 100% ↔ 80%' ~/scripts/cpu-cap.sh",
        "return-type": "json", "interval": 30, "signal": 14,
        "on-click": "~/bin/i3blocks-waybar --signal 14 ~/scripts/cpu-cap.sh 1",
        "on-click-right": "~/bin/i3blocks-waybar --signal 14 ~/scripts/cpu-cap.sh 3"
    },
    "custom/power-profile": {
        "exec": "~/bin/i3blocks-waybar --hint 'click: next power profile' ~/scripts/power-profile.sh",
        "return-type": "json", "interval": 30, "signal": 12,
        "on-click": "~/bin/i3blocks-waybar --signal 12 ~/scripts/power-profile.sh 1"
    },
    "custom/battery": {
        "exec": "~/bin/i3blocks-waybar --hint 'right: upower details' ~/scripts/battery.sh",
        "return-type": "json", "interval": 30,
        "on-click-right": "~/bin/i3blocks-waybar ~/scripts/battery.sh 3"
    },
    "custom/uptime": {
        "exec": "~/bin/i3blocks-waybar --hint 'right: systemd-analyze blame' ~/scripts/uptime.sh",
        "return-type": "json", "interval": 60,
        "on-click-right": "~/bin/i3blocks-waybar ~/scripts/uptime.sh 3"
    },

    // i3's screenshot.sh shells out to scrot, which is X11-only and does nothing
    // here. Same button, niri's own screenshot actions behind it.
    "custom/screenshot": {
        "exec": "~/bin/i3blocks-waybar --hint 'left: region · right: whole screen' ~/scripts/screenshot.sh",
        "return-type": "json", "interval": "once",
        "on-click": "niri msg action screenshot",
        "on-click-right": "niri msg action screenshot-screen"
    },

    // ---- native -------------------------------------------------------------
    // volume.sh / mic.sh look: red when muted, mic icon only.
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 MUTE",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "tooltip-format": "{desc}\nleft: mute · right: pavucontrol · scroll: ±5%",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "scroll-step": 5
    },
    "pulseaudio#mic": {
        "format": "{format_source}",
        "format-source": "󰍬",
        "format-source-muted": "󰍭",
        "tooltip-format": "mic {source_volume}%\nclick: mute",
        "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
    },
    "tray": { "spacing": 8 },
    // datetime.sh's format and clicks. Native because it ticks on the minute;
    // the script polled every 30s.
    "clock": {
        "format": "{:%a %d %b %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "on-click": "alacritty -e bash -c \"cal -3; read -p 'Press enter to close...'\"",
        "on-click-right": "alacritty -e bash -c \"cal -y; read -p 'Press enter to close...'\""
    }
}
