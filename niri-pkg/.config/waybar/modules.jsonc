// Module definitions, shared by both bars in config.jsonc (its "include").
// A bar there can override single keys of a module; what it leaves out comes
// from here.
//
// cffi/* are bardeck strips (see config.jsonc): bar-strip.so shows the picture
// bardeck drew ("strip" + "variant", at "scale"), and sends it hover / left click /
// scroll. Hover opens the strip's panel, a left click pins it. Middle and right
// clicks are waybar's own, below; the right ones keep the menus of the i3blocks
// scripts the old blocks ran (the same menus as on i3). module_path takes no "~".
//
// Nerd Font icons here are raw private-use characters (U+F0000 and up). Some
// editors and tools drop them silently and leave a plain space. After an edit,
// check they survived:
//     grep -oP '[\x{F0000}-\x{FFFFD}]' ~/.config/waybar/modules.jsonc | wc -l   # expect 0
{
    // The engine. Prints nothing, so it takes no space; dies with waybar. Both bars
    // start one; the second waits on a lock.
    "custom/bardeck": {
        "exec": "~/bin/bardeck daemon",
        "tooltip": false
    },

    // Workspaces of this bar's output, with a mark per column (an app icon, or a
    // terminal's title). Click: a workspace or a window. Scroll: the next one. Right
    // click: the overview (every workspace and window, pinned; bardeck/ws.py WsPanel).
    // No hover panel, so no hover.
    "cffi/ws": {
        "module_path": "/home/tgrining/.config/waybar/bar-strip.so",
        "strip": "ws", "variant": "full", "scale": 1, "per-output": true, "hover-ms": 0,
        "right-click": true
    },
    // Panel: the time to the second, UTC, two months with ISO weeks. Right click:
    // the whole year (pinned; y toggles, u/p a year). "right-click": bar-strip.so
    // sends the right click to bardeck instead of to waybar.
    "cffi/clock": {
        "module_path": "/home/tgrining/.config/waybar/bar-strip.so",
        "strip": "clock", "variant": "full", "scale": 1, "right-click": true
    },
    // Panel: every account's quota week (qtop's chart). Middle: qtop. Right: switch account.
    "cffi/quota": {
        "module_path": "/home/tgrining/.config/waybar/bar-strip.so",
        "strip": "quota", "variant": "full", "scale": 1,
        "on-click-middle": "alacritty -e qtop",
        "on-click-right": "~/bin/i3blocks-waybar ~/scripts/claude-usage.sh 3"
    },
    // Panel: 5 min of CPU / memory / temperature, every core, the busiest processes,
    // disks, updates. Middle: htop. Right: htop by memory.
    "cffi/sys": {
        "module_path": "/home/tgrining/.config/waybar/bar-strip.so",
        "strip": "sys", "variant": "full", "scale": 1,
        "on-click-middle": "alacritty -e htop",
        "on-click-right": "alacritty -e htop -s PERCENT_MEM"
    },
    // Panel: the link, 5 min of traffic, VPN switches, network actions.
    // Right: network.sh's menu.
    "cffi/net": {
        "module_path": "/home/tgrining/.config/waybar/bar-strip.so",
        "strip": "net", "variant": "full", "scale": 1,
        "on-click-right": "~/bin/i3blocks-waybar ~/scripts/network.sh 3"
    },
    // Panel: Bluetooth and its devices, connect / disconnect, where sound goes.
    // Right: bluetooth.sh's menu.
    "cffi/dev": {
        "module_path": "/home/tgrining/.config/waybar/bar-strip.so",
        "strip": "dev", "variant": "full", "scale": 1,
        "on-click-right": "~/bin/i3blocks-waybar ~/scripts/bluetooth.sh 3"
    },
    // Panel: the player (cover, progress, buttons; several players: pick one), every
    // output and input with a slider and mute, every app's stream (bardeck/audio.py).
    // Drawn on PulseAudio's and the players' own events. Scroll: ±5% on the default
    // output. Middle: mute. Right: pavucontrol.
    "cffi/audio": {
        "module_path": "/home/tgrining/.config/waybar/bar-strip.so",
        "strip": "audio", "variant": "full", "scale": 1,
        "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },
    // Panel: the battery's 24 h, power profile and turbo boost switches, keep awake
    // (caffeine), a running recording's stop. Right: power-profile.sh's menu.
    "cffi/power": {
        "module_path": "/home/tgrining/.config/waybar/bar-strip.so",
        "strip": "power", "variant": "full", "scale": 1,
        "on-click-right": "~/bin/i3blocks-waybar ~/scripts/power-profile.sh 1"
    },
    // Panel: the screens drawn where they are, the selected one's on / off, scale,
    // rotation, VRR and modes, and niri-screen-switch's entries as presets.
    // Right: niri-screen-switch's menu (Mod+BackSpace).
    "cffi/disp": {
        "module_path": "/home/tgrining/.config/waybar/bar-strip.so",
        "strip": "disp", "variant": "full", "scale": 1,
        "on-click-right": "~/bin/niri-screen-switch"
    },

    // Panel: dunst's history (newest first, by app; click one: shown again, hover: ×
    // removes it), Do Not Disturb, clear all. Middle: Do Not Disturb on / off.
    // Right: the last notification again.
    "cffi/notif": {
        "module_path": "/home/tgrining/.config/waybar/bar-strip.so",
        "strip": "notif", "variant": "full", "scale": 1,
        "on-click-middle": "dunstctl set-paused toggle",
        "on-click-right": "dunstctl history-pop"
    },
    // Panel: the Claude agent sessions (waiting ones first; click: a terminal attached
    // to its tmux session), slotq's queue, Tomek's open MRs (click: the browser).
    // bardeck/agents.py; it reads rcmon (GitLab only while rcmon is down). Right: cmon.
    "cffi/agents": {
        "module_path": "/home/tgrining/.config/waybar/bar-strip.so",
        "strip": "agents", "variant": "full", "scale": 1,
        "on-click-right": "alacritty -e ~/bin/cmon"
    },

    "tray": { "spacing": 8, "icon-size": 16 }
}
