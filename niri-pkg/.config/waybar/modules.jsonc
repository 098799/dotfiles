// Module definitions, shared by both bars in config.jsonc (its "include").
// A bar there can override single keys of a module; what it leaves out comes
// from here.
//
// cffi/* are bardeck strips (see config.jsonc): bar-strip.so shows the picture
// bardeck drew ("strip" + "variant", at "scale"), and sends it hover / left click /
// scroll. Hover opens the strip's panel, a left click pins it. Middle and right
// clicks are waybar's own, below; the right ones keep the menus of the i3blocks
// scripts the old blocks ran (the same menus as on i3). module_path takes no "~".
//
// Nerd Font icons here are raw private-use characters (U+F0000 and up). Some
// editors and tools drop them silently and leave a plain space. After an edit,
// check they survived:
//     grep -oP '[\x{F0000}-\x{FFFFD}]' ~/.config/waybar/modules.jsonc | wc -l   # expect 6
{
    // The engine. Prints nothing, so it takes no space; dies with waybar. Both bars
    // start one; the second waits on a lock.
    "custom/bardeck": {
        "exec": "~/bin/bardeck daemon",
        "tooltip": false
    },

    // Workspaces of this bar's output, with a mark per column (an app icon, or a
    // terminal's title). Click: a workspace or a window. Scroll: the next one. No
    // panel, so no hover.
    "cffi/ws": {
        "module_path": "/home/tgrining/.config/waybar/bar-strip.so",
        "strip": "ws", "variant": "full", "scale": 1, "per-output": true, "hover-ms": 0
    },
    // Panel: the time to the second, UTC, two months with ISO weeks.
    "cffi/clock": {
        "module_path": "/home/tgrining/.config/waybar/bar-strip.so",
        "strip": "clock", "variant": "full", "scale": 1,
        "on-click-right": "alacritty -e bash -c \"cal -y; read -p 'Press enter to close...'\""
    },
    // Panel: every account's quota week (qtop's chart). Middle: qtop. Right: switch account.
    "cffi/quota": {
        "module_path": "/home/tgrining/.config/waybar/bar-strip.so",
        "strip": "quota", "variant": "full", "scale": 1,
        "on-click-middle": "alacritty -e qtop",
        "on-click-right": "~/bin/i3blocks-waybar ~/scripts/claude-usage.sh 3"
    },
    // Panel: 5 min of CPU / memory / temperature, every core, the busiest processes,
    // disks, updates. Middle: htop. Right: htop by memory.
    "cffi/sys": {
        "module_path": "/home/tgrining/.config/waybar/bar-strip.so",
        "strip": "sys", "variant": "full", "scale": 1,
        "on-click-middle": "alacritty -e htop",
        "on-click-right": "alacritty -e htop -s PERCENT_MEM"
    },
    // Panel: the link, 5 min of traffic, VPN switches, network actions.
    // Right: network.sh's menu.
    "cffi/net": {
        "module_path": "/home/tgrining/.config/waybar/bar-strip.so",
        "strip": "net", "variant": "full", "scale": 1,
        "on-click-right": "~/bin/i3blocks-waybar ~/scripts/network.sh 3"
    },
    // Panel: Bluetooth and its devices, connect / disconnect, where sound goes.
    // Right: bluetooth.sh's menu.
    "cffi/dev": {
        "module_path": "/home/tgrining/.config/waybar/bar-strip.so",
        "strip": "dev", "variant": "full", "scale": 1,
        "on-click-right": "~/bin/i3blocks-waybar ~/scripts/bluetooth.sh 3"
    },
    // Panel: the battery's 24 h, power profile and turbo boost switches.
    // Right: power-profile.sh's menu.
    "cffi/power": {
        "module_path": "/home/tgrining/.config/waybar/bar-strip.so",
        "strip": "power", "variant": "full", "scale": 1,
        "on-click-right": "~/bin/i3blocks-waybar ~/scripts/power-profile.sh 1"
    },

    // Native, because they follow PulseAudio events (no key bind has to signal the
    // bar) and scroll changes the volume. One pill for both.
    "group/audio": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "pulseaudio#mic"]
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 mute",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "tooltip-format": "{desc}\nleft: mute · right: pavucontrol · scroll: ±5%",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "scroll-step": 5
    },
    "pulseaudio#mic": {
        "format": "{format_source}",
        "format-source": "󰍬",
        "format-source-muted": "󰍭",
        "tooltip-format": "mic {source_volume}%\nclick: mute",
        "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
    },
    "tray": { "spacing": 8, "icon-size": 16 }
}
