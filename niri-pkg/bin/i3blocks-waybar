#!/usr/bin/env -S python3 -I
"""Run an i3blocks script and emit waybar JSON.

The niri bar runs the SAME ~/scripts/*.sh that i3blocks runs, so both bars show
the same icons, text and colours, and keep the same click menus. This adapter
translates the protocol.

i3blocks: up to 3 lines on stdout -- full_text, short_text, colour (#rrggbb).
Clicks arrive as $BLOCK_BUTTON (1 left, 2 middle, 3 right, 4/5 scroll).

waybar: one JSON object with "text" (full_text), "alt" (short_text) and
"tooltip". waybar renders labels as pango markup, so the colour becomes a <span>.

    i3blocks-waybar ~/scripts/uptime.sh                  # read it
    i3blocks-waybar ~/scripts/cpu-cap.sh 1               # left-click it
    i3blocks-waybar --signal 14 ~/scripts/cpu-cap.sh 1   # ...then redraw the block
    i3blocks-waybar --timeout 120 ~/scripts/updates.sh   # a read that may be slow
    i3blocks-waybar --hint 'right: df' ~/scripts/disk.sh # say what a click does

A read gives up after 10s by default, so one stuck bluetoothctl cannot freeze a
block. updates.sh runs checkupdates on a cold cache, which takes longer.

A read must stay cheap, because waybar runs it for every block, on every bar
(one bar per screen), every few seconds -- about 70% of a core on 7 Oct 2026,
on a machine already at load 70. So:

  * One run serves both bars. The answer is kept SHARE_FOR seconds in
    $XDG_RUNTIME_DIR/i3blocks-waybar/cache, and a lock stops the same script
    from running twice at once: the second bar waits and takes the first one's
    answer. A click drops the answer, so the redraw after it is new.
  * The script runs at nice NICE, so the bar gives way to real work.
  * A timeout kills the script's whole process group. Killing bash alone left
    its stuck children running, one more on every tick.
  * A script that times out shows its last answer, up to STALE_FOR seconds
    old, instead of an empty block.
  * python3 -I: no site-packages scan, a quarter of the start-up time.

A click is not a read, and it runs differently:

  * No timeout. A click often opens a rofi menu and waits for you. A timeout
    killed the script under the open menu, and whatever you picked went nowhere.
  * No captured output. Scripts start `alacritty ... &`; a captured stdout kept
    the adapter alive until that terminal closed.
  * Menus from ~/bin/barmenu. A `rofi` shim on PATH sends `rofi -dmenu` there:
    it opens under the block you clicked and closes on a click outside, which
    Wayland rofi at an `xdotool getmouselocation` position did neither of (see
    barmenu). Any other rofi call goes to the real rofi.
  * --signal N sends SIGRTMIN+N to waybar when the script returns, and again a
    few seconds later for the things scripts start in the background
    (bluetoothctl connect, wg-quick up), so the block shows the new state.
"""
import fcntl
import html
import json
import os
import signal
import subprocess
import sys
import time

READ_TIMEOUT = 10
RESIGNAL_AFTER = 4
SHARE_FOR = 2
STALE_FOR = 300
NICE = 10

BARMENU = os.path.join(os.path.dirname(os.path.realpath(__file__)), "barmenu")
SHIM = f"""#!/bin/sh
for arg; do
    [ "$arg" = -dmenu ] && exec {BARMENU} "$@"
done
exec /usr/bin/rofi "$@"
"""


def runtime_dir() -> str:
    return os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "i3blocks-waybar")


def cache_file(script: str) -> str:
    path = os.path.join(runtime_dir(), "cache")
    os.makedirs(path, exist_ok=True)
    return os.path.join(path, script.strip("/").replace("/", "_"))


def cached(path: str, max_age: float) -> str | None:
    try:
        if time.time() - os.stat(path).st_mtime >= max_age:
            return None
        with open(path) as f:
            return f.read()
    except OSError:
        return None


def drop_cached(script: str) -> None:
    try:
        os.unlink(cache_file(script))
    except OSError:
        pass


def run_script(script: str, timeout: int) -> str | None:
    try:
        proc = subprocess.Popen(
            [script], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            text=True, start_new_session=True,
        )
    except OSError:
        return None
    try:
        return proc.communicate(timeout=timeout)[0]
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)
        proc.wait()
        return None


def shared_read(script: str, timeout: int) -> str | None:
    path = cache_file(script)
    out = cached(path, SHARE_FOR)
    if out is not None:
        return out
    with open(path + ".lock", "w") as lock:
        deadline = time.monotonic() + timeout
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    return cached(path, STALE_FOR)
                time.sleep(0.05)
        # The other bar held the lock, so it has likely just written the answer.
        out = cached(path, SHARE_FOR)
        if out is not None:
            return out
        out = run_script(script, timeout)
        if out is None:
            return cached(path, STALE_FOR)
        tmp = f"{path}.{os.getpid()}"
        with open(tmp, "w") as f:
            f.write(out)
        os.replace(tmp, path)
        return out


def shim_dir() -> str:
    path = runtime_dir()
    shim = os.path.join(path, "rofi")
    try:
        with open(shim) as f:
            if f.read() == SHIM:
                return path
    except OSError:
        pass
    os.makedirs(path, exist_ok=True)
    with open(shim, "w") as f:
        f.write(SHIM)
    os.chmod(shim, 0o755)
    return path


def signal_waybar(number: int) -> None:
    subprocess.run(["pkill", f"-RTMIN+{number}", "-x", "waybar"], check=False)


def click(script: str, button: str, signal_number: int | None) -> int:
    env = dict(os.environ, BLOCK_BUTTON=button)
    if env.get("WAYLAND_DISPLAY"):
        env["PATH"] = shim_dir() + os.pathsep + env.get("PATH", "")
    try:
        subprocess.run([script], env=env, stdout=subprocess.DEVNULL, check=False)
    except OSError:
        return 1
    drop_cached(script)
    if signal_number is not None:
        signal_waybar(signal_number)
        time.sleep(RESIGNAL_AFTER)
        drop_cached(script)
        signal_waybar(signal_number)
    return 0


def read(script: str, timeout: int, hint: str) -> int:
    os.nice(NICE)
    out = shared_read(script, timeout)
    if out is None:
        print(json.dumps({"text": ""}), flush=True)
        return 0

    lines = out.split("\n")
    full = lines[0].strip() if lines else ""
    short = lines[1].strip() if len(lines) > 1 else ""
    colour = lines[2].strip() if len(lines) > 2 else ""

    if not full:
        print(json.dumps({"text": ""}), flush=True)
        return 0

    # i3blocks scripts already emit pango markup in some cases; only escape when
    # there is no markup to preserve.
    def markup(line: str) -> str:
        return line if "<" in line else html.escape(line)

    def coloured(line: str) -> str:
        if colour.startswith("#"):
            return f'<span color="{colour}">{markup(line)}</span>'
        return markup(line)

    # "alt" is short_text, for a bar with too little room (the laptop bar shows
    # it with "format": "{alt}"). i3bar switched to it by itself on overflow.
    # A script with no short_text gets its full_text, as in i3bar.
    # The tooltip always has the full text, so a short block loses nothing.
    tooltip = markup(full)
    if hint:
        tooltip = f"{tooltip}\n{hint}"
    print(json.dumps({"text": coloured(full), "alt": coloured(short or full), "tooltip": tooltip}), flush=True)
    return 0


def main() -> int:
    args = sys.argv[1:]
    signal_number = None
    timeout = READ_TIMEOUT
    hint = ""
    while len(args) >= 2 and args[0] in ("--signal", "--timeout", "--hint"):
        if args[0] == "--signal":
            signal_number = int(args[1])
        elif args[0] == "--timeout":
            timeout = int(args[1])
        else:
            hint = args[1]
        args = args[2:]
    if not args:
        print(json.dumps({"text": "", "tooltip": "usage: i3blocks-waybar [--signal N] [--timeout S] [--hint TEXT] <script> [button]"}))
        return 2

    script = os.path.expanduser(args[0])
    if len(args) > 1:
        return click(script, args[1], signal_number)
    return read(script, timeout, hint)


if __name__ == "__main__":
    sys.exit(main())
