#!/bin/bash
# Run scripts when a screen is plugged in or pulled out. Started by startup.kdl.
#
# niri's event stream has no output events, so this listens to the kernel's DRM
# hotplug uevents (udevadm monitor, no root needed) and compares the set of
# connected outputs before and after. A replug fires several uevents within a
# second; they are drained first, then niri is asked once.
#
# Built in (laptop only: nothing happens on a machine without eDP-1):
#   a DP-* monitor connected       -> niri-screen-switch layout-external: that monitor
#                                     alone, at its preferred mode; the laptop panel off
#   a DP-* monitor already there   -> the same, once, when this script starts (login)
#   the last external one removed  -> niri-screen-switch "Screen: laptop only"
#                                     (a laptop panel left off would mean no screen at all)
#   HDMI (the TV) connected        -> nothing: game mode wakes it and sets it up
# Then every executable in ~/.config/niri/hotplug.d/ runs once per change:
#   <script> connect|disconnect <output> <description>
#
# Log: journalctl --user -t niri-hotplug

set -u

LAPTOP=eDP-1
SWITCH=/home/tgrining/bin/niri-screen-switch
HOOKS=/home/tgrining/.config/niri/hotplug.d

log() { logger -t niri-hotplug -- "$*"; }

# One line per connected output: "<name>\t<make model serial>".
connected() {
    niri msg -j outputs 2>/dev/null \
        | jq -r 'to_entries[] | "\(.key)\t\(.value.make) \(.value.model) \(.value.serial // "")"' | sort
}

run_hooks() {
    local h
    [[ -d $HOOKS ]] || return 0
    for h in "$HOOKS"/*; do
        [[ -f $h && -x $h ]] || continue
        "$h" "$@" >/dev/null 2>&1 </dev/null || log "hook $h $1 $2 exited $?"
    done
}

react() {
    local before=$1 after=$2 name desc added removed
    added=$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after") | sed '/^$/d')
    removed=$(comm -23 <(printf '%s\n' "$before") <(printf '%s\n' "$after") | sed '/^$/d')
    [[ -n $added$removed ]] || return 0

    if grep -q "^$LAPTOP"$'\t' <<<"$after"; then
        if grep -q '^DP-' <<<"$added"; then
            log "external monitor connected: $(grep '^DP-' <<<"$added" | tr '\t' ' ' | head -1)"
            "$SWITCH" layout-external
        elif [[ -n $removed ]] && ! grep -qv "^$LAPTOP"$'\t' <<<"$after"; then
            log "last external screen removed: $(tr '\t' ' ' <<<"$removed" | head -1)"
            "$SWITCH" "Screen: laptop only"
        fi
    fi

    while IFS=$'\t' read -r name desc; do
        [[ -n $name ]] && run_hooks disconnect "$name" "$desc"
    done <<<"$removed"
    while IFS=$'\t' read -r name desc; do
        [[ -n $name ]] && run_hooks connect "$name" "$desc"
    done <<<"$added"
}

# One copy per session: niri re-runs nothing on a config reload, but a manual
# start next to the startup one would switch layouts twice.
exec 9>"${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/niri-hotplug.lock"
flock -n 9 || { echo "niri-hotplug: already running" >&2; exit 0; }

state=$(connected)
log "watching; connected: $(cut -f1 <<<"$state" | tr '\n' ' ')"
if grep -q "^$LAPTOP"$'\t' <<<"$state" && grep -q '^DP-' <<<"$state"; then
    log "external monitor present at start: external only"
    "$SWITCH" layout-external
fi

while read -r line; do
    [[ $line == UDEV* ]] || continue
    # Drain the burst; one check after it ends.
    while read -r -t 1.5 _; do :; done
    new=$(connected)
    react "$state" "$new"
    state=$new
done < <(udevadm monitor --udev --subsystem-match=drm)
