#!/usr/bin/env python3
"""Minimap of the scroll strip, shown for a moment when you change workspace.

A niri workspace is an endless row of columns, and the screen shows one piece
of it. Nothing on screen says how much of the row is off to the left or right.
When you switch to another workspace, this draws that workspace's whole row,
scaled down, in the bottom-right corner for a few seconds:

  frame        the part of the row that is on the screen now; the rest is dimmed
  tiles        windows at their true widths, with app icon and title; the
               focused one is green
  header       workspace name, focused column (3 / 7), and how many columns are
               off screen each side (◀ 2   1 ▶)

Only a workspace switch brings it up. While it is up it follows the workspace:
a scroll slides the frame, a new or closed column redraws the row.

It is an overlay layer surface with an empty input region: clicks and keys go
through it.

The widths are exact, because niri reports every tile's size. The frame is an
estimate: niri's IPC does not say where the view is (`tile_pos_in_workspace_view`
is null for tiled windows), so this script replays niri's own view rule for
`center-focused-column "never"` + `always-center-single-column` on every
change. That is exact for keyboard moves. A touchpad swipe or a mouse drag of
the view is not replayed, so after one the frame can be off until niri next
has to scroll to a column (it then snaps to that column's edge again).

  niri-minimap              run the daemon (niri starts it; a second run replaces the first)
  niri-minimap --show       show the minimap now
  niri-minimap --png FILE [WORKSPACE]
                            draw a workspace (default: the focused one) into FILE, no window
"""
import json
import math
import os
import re
import signal
import subprocess
import sys

import cairo
import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Gdk, Gio, GLib, Gtk, GtkLayerShell, Pango, PangoCairo  # noqa: E402

SHOW_MS = 4000  # fully visible for this long after it comes up
FADE_IN_MS = 110
FADE_OUT_MS = 260
SLIDE_MS = 180  # the frame's glide when the view scrolls while it is up
MAX_SCALE = 0.12  # one screen of strip is never drawn bigger than this
MAX_W_FRAC = 0.40  # the card never takes more than this share of the screen width
DEFAULT_GAP = 10.0
LAYOUT_KDL = os.path.expanduser("~/.config/niri/layout.kdl")
PIDFILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "niri-minimap.pid")

# Spacing. Everything sits on a 4px grid, and radii nest: an inner corner's
# radius is the outer one's minus the space between them, so the curves run
# parallel instead of pinching.
PAD = 16  # card edge to the outermost ink (cap tops, the frame line), all four sides
HEADER_GAP = 12  # header baseline to the frame line's outer edge
SHADOW = 24  # room for the soft shadow around the card
GUTTER = 4  # px between two tiles, and between a tile and the frame line
FRAME_OUT = GUTTER // 2 + 1  # strip edge to the frame line's outer edge (3)
FRAME_R = 6  # the row's track; the frame line's outer edge is FRAME_R + FRAME_OUT
CARD_R = FRAME_R + FRAME_OUT + PAD  # 25
TILE_INSET = 8  # tile edge to its icon/title
TABS_INSET = 4  # tile edge to a tabbed column's tab strip
FONT = "Terminess Nerd Font Propo"
NAME_PX = 17
META_PX = 14
TITLE_PX = 12

# gruvbox-dark, the palette of ~/.config/waybar/style.css and niri's borders


def hex_rgb(h: str) -> tuple[float, float, float]:
    return tuple(int(h[i : i + 2], 16) / 255 for i in (1, 3, 5))


BG0_H = hex_rgb("#1d2021")
BG1 = hex_rgb("#3c3836")
BG2 = hex_rgb("#504945")
FG = hex_rgb("#ebdbb2")
FG4 = hex_rgb("#a89984")
GRAY = hex_rgb("#7c6f64")
GREEN = hex_rgb("#98971a")
BRIGHT = hex_rgb("#b8bb26")
ACCENT_FG = hex_rgb("#fbf1c7")  # waybar's text on a focused (green) pill

windows: dict[int, dict] = {}
workspaces: dict[int, dict] = {}
outputs: dict[str, dict] = {}
# ws id -> (anchor window id, view x minus the anchor column's x). niri keeps
# the view offset relative to the active column the same way, so a column
# opening or closing to the left moves the view with the row, as on screen.
views: dict[int, tuple[int | None, float]] = {}


def niri_json(*args: str):
    out = subprocess.run(
        ["niri", "msg", "-j", *args], capture_output=True, text=True, check=False
    ).stdout
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return None


def read_outputs() -> None:
    data = niri_json("outputs") or {}
    outputs.clear()
    outputs.update({name: o["logical"] for name, o in data.items() if o.get("logical")})


def gaps() -> float:
    # niri-gaps rewrites this line at runtime, so read it each time.
    try:
        with open(LAYOUT_KDL, encoding="utf-8") as f:
            m = re.search(r"^\s*gaps\s+(\d+(?:\.\d+)?)", f.read(), re.M)
    except OSError:
        return DEFAULT_GAP
    return float(m.group(1)) if m else DEFAULT_GAP


def columns_of(ws_id: int) -> list[list[dict]]:
    """Tiled windows of a workspace, as columns left to right, tiles top to bottom."""
    cols: dict[int, list[dict]] = {}
    for w in windows.values():
        pos = w.get("layout", {}).get("pos_in_scrolling_layout")
        if w["workspace_id"] == ws_id and not w["is_floating"] and pos:
            cols.setdefault(pos[0], []).append(w)
    return [
        sorted(cols[c], key=lambda w: w["layout"]["pos_in_scrolling_layout"][1])
        for c in sorted(cols)
    ]


def col_width(col: list[dict]) -> float:
    return max(w["layout"]["tile_size"][0] for w in col)


def col_xs(cols: list[list[dict]], gap: float) -> list[float]:
    xs, x = [], 0.0
    for c in cols:
        xs.append(x)
        x += col_width(c) + gap
    return xs


def fit(cur_x: float, view_w: float, col_x: float, width: float, gap: float) -> float:
    """niri's compute_new_view_offset: the view offset from col_x that shows the column."""
    if view_w <= width:
        return 0.0  # wider than the screen: left-aligned, no padding
    padding = min(max((view_w - width) / 2, 0.0), gap)
    left, right = col_x - padding, col_x + width + padding
    if cur_x <= left and right <= cur_x + view_w:
        return cur_x - col_x  # already fully on screen: the view stays
    if abs(cur_x - left) <= abs(cur_x + view_w - right):
        return -padding
    return -(view_w - padding - width)


def column_index(cols: list[list[dict]], window_id: int | None) -> int | None:
    for i, c in enumerate(cols):
        if any(w["id"] == window_id for w in c):
            return i
    return None


def update_view(ws_id: int) -> None:
    ws = workspaces.get(ws_id)
    cols = columns_of(ws_id)
    out = outputs.get(ws.get("output") or "") if ws else None
    if not cols or not out:
        views.pop(ws_id, None)
        return
    view_w, gap = out["width"], gaps()
    xs = col_xs(cols, gap)
    active_id = ws.get("active_window_id")
    ai = column_index(cols, active_id)
    if ai is None:
        ai, active_id = 0, cols[0][0]["id"]
    width = col_width(cols[ai])

    if len(cols) == 1:
        off = 0.0 if width >= view_w else -(view_w - width) / 2
    else:
        prev = views.get(ws_id)
        if prev is None:
            cur_x = -gap  # never seen: assume the row starts at the left edge
        else:
            anchor, prev_off = prev
            pi = column_index(cols, anchor)
            cur_x = xs[ai if pi is None else pi] + prev_off
        off = fit(cur_x, view_w, xs[ai], width, gap)
    views[ws_id] = (active_id, off)


def snapshot(ws_id: int) -> dict | None:
    """Everything the drawing needs, frozen, so a fade-out shows what it showed."""
    ws = workspaces.get(ws_id)
    out = outputs.get(ws.get("output") or "") if ws else None
    if not ws or not out:
        return None
    cols = columns_of(ws_id)
    gap = gaps()
    xs = col_xs(cols, gap)
    view_x, active = -gap, 0
    if ws_id in views and cols:
        anchor, off = views[ws_id]
        i = column_index(cols, anchor)
        active = i if i is not None else 0
        view_x = xs[active] + off
    return {
        "ws_id": ws_id,
        "name": ws.get("name") or str(ws["idx"]),
        "out": dict(out),
        "gap": gap,
        "cols": [[dict(w) for w in c] for c in cols],
        "xs": xs,
        "view_x": view_x,
        "active": active,
        "focused_id": next((w["id"] for w in windows.values() if w.get("is_focused")), None),
    }


# ---- drawing -------------------------------------------------------------------


def rounded(cr, x, y, w, h, r) -> None:
    r = max(0.0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


class Text:
    """A one-line Pango layout that knows its ink box and baseline."""

    def __init__(self, cr, s: str, px: float, bold: bool = False, max_w: float | None = None):
        self.layout = PangoCairo.create_layout(cr)
        desc = Pango.FontDescription.from_string(FONT)
        desc.set_absolute_size(px * Pango.SCALE)
        if bold:
            desc.set_weight(Pango.Weight.BOLD)
        self.layout.set_font_description(desc)
        self.layout.set_text(s, -1)
        if max_w is not None:
            self.layout.set_width(int(max(1, max_w) * Pango.SCALE))
            self.layout.set_ellipsize(Pango.EllipsizeMode.END)
        ink, logical = self.layout.get_pixel_extents()
        self.width = logical.width if max_w is None else min(logical.width, max_w)
        self.ink_x, self.ink_w = ink.x, ink.width
        self.baseline = self.layout.get_baseline() / Pango.SCALE
        # cap height, measured on the font's own "H": the box a label optically fills
        probe = PangoCairo.create_layout(cr)
        probe.set_font_description(desc)
        probe.set_text("H", -1)
        h_ink, _ = probe.get_pixel_extents()
        self.cap = probe.get_baseline() / Pango.SCALE - h_ink.y

    def draw(self, cr, x: float, baseline_y: float, rgba) -> None:
        """Draw with the baseline at baseline_y, and the first ink column at x."""
        cr.set_source_rgba(*rgba)
        cr.move_to(round(x - self.ink_x), round(baseline_y - self.baseline))
        PangoCairo.show_layout(cr, self.layout)


_apps: dict[str, tuple] = {}


def app_info(app_id: str) -> tuple:
    """(Gio.Icon or None, display name or None) for a Wayland app_id, cached."""
    if app_id in _apps:
        return _apps[app_id]
    found = (None, None)
    for cand in dict.fromkeys((app_id, app_id.lower())):
        try:
            info = Gio.DesktopAppInfo.new(f"{cand}.desktop")
        except TypeError:
            info = None
        if info is not None:
            found = (info.get_icon(), info.get_name())
            break
    if found[0] is None and app_id:
        found = (Gio.ThemedIcon.new_with_default_fallbacks(app_id.lower()), found[1])
    _apps[app_id] = found
    return found


_pixbufs: dict[tuple[str, int], object] = {}


def app_pixbuf(app_id: str, size: int):
    key = (app_id, size)
    if key not in _pixbufs:
        pix = None
        gicon, _ = app_info(app_id)
        theme = Gtk.IconTheme.get_default()
        if gicon is not None and theme is not None:
            info = theme.lookup_by_gicon(gicon, size, Gtk.IconLookupFlags.FORCE_SIZE)
            if info is not None:
                try:
                    pix = info.load_icon()
                except GLib.Error:
                    pix = None
        _pixbufs[key] = pix
    return _pixbufs[key]


def short_title(w: dict) -> str:
    """The title without a trailing ' - Google Chrome' that only repeats the app."""
    title = (w.get("title") or "").strip()
    _, name = app_info(w.get("app_id") or "")
    for suffix in filter(None, (name, w.get("app_id"))):
        for sep in (" - ", " — ", " – "):
            if title.lower().endswith((sep + suffix).lower()):
                return title[: -len(sep + suffix)].strip()
    return title or (w.get("app_id") or "")


def draw_tile(cr, w: dict, x: int, y: int, tw: int, th: int, focused: bool, alpha: float) -> None:
    """One window. (x, y, tw, th) are whole pixels: the tile's outer edge."""
    r = max(1.0, min(FRAME_R - GUTTER / 2, tw / 6, th / 6))
    # Fill the whole pixel box, then stroke 0.5px inside it, so a 1px border
    # lands on exactly one row of pixels instead of smearing over two.
    rounded(cr, x, y, tw, th, r)
    grad = cairo.LinearGradient(0, y, 0, y + th)
    if focused:
        grad.add_color_stop_rgba(0, *mix(GREEN, BG0_H, 0.78), alpha)
        grad.add_color_stop_rgba(1, *mix(GREEN, BG0_H, 0.60), alpha)
    else:
        grad.add_color_stop_rgba(0, *BG2, alpha)
        grad.add_color_stop_rgba(1, *BG1, alpha)
    cr.set_source(grad)
    cr.fill()
    rounded(cr, x + 0.5, y + 0.5, tw - 1, th - 1, r - 0.5)
    cr.set_line_width(1)
    cr.set_source_rgba(*(BRIGHT if focused else FG4), (0.95 if focused else 0.26) * alpha)
    cr.stroke()
    if th > 2 * r + 2 and tw > 2 * r + 2:  # a 1px lip of light along the top edge
        cr.move_to(x + r, y + 1.5)
        cr.line_to(x + tw - r, y + 1.5)
        cr.set_source_rgba(*FG, (0.20 if focused else 0.09) * alpha)
        cr.stroke()

    # Icon over title, the pair centred as one block. Each drops out when the
    # tile cannot hold it with TILE_INSET clear on every side.
    inner_w, inner_h = tw - 2 * TILE_INSET, th - 2 * TILE_INSET
    icon = min(40, int(inner_w * 0.4), int(inner_h * 0.34)) // 2 * 2
    icon = icon if icon >= 16 else 0
    title = Text(cr, short_title(w), TITLE_PX, max_w=inner_w) if inner_w >= 40 else None
    line_h = TITLE_PX + 3
    gap_it = 8 if icon else 0
    block = icon + ((gap_it + line_h) if title else 0)
    if title and block > inner_h:
        title, block = None, icon
    if not block:
        return
    top = y + round((th - block) / 2)
    if icon:
        pix = app_pixbuf(w.get("app_id") or "", icon)
        if pix is not None:
            Gdk.cairo_set_source_pixbuf(cr, pix, x + (tw - icon) // 2, top)
            cr.paint_with_alpha((1.0 if focused else 0.9) * alpha)
    if title:
        tx = x + (tw - title.width) / 2
        ink = (*ACCENT_FG, alpha) if focused else (*FG, 0.85 * alpha)
        # baseline so the cap height sits in the lower line box, optically centred
        title.draw(cr, tx + title.ink_x, top + icon + gap_it + (line_h + title.cap) / 2, ink)


def mix(a, b, t: float) -> tuple[float, float, float]:
    """a over b at opacity t, as an opaque colour: nothing behind shows through."""
    return tuple(x * t + y * (1 - t) for x, y in zip(a, b))


def column_shape(col: list[dict], gap: float, out_h: float, focused_id) -> tuple[list[dict], float, bool]:
    """(tiles to draw, top y of the first, tabbed?) for one column."""
    heights = [w["layout"]["tile_size"][1] for w in col]
    stacked_h = sum(heights) + gap * (len(col) - 1)
    if len(col) > 1 and stacked_h > out_h - 2 * gap + 1:  # tabbed: tiles overlap
        return [next((w for w in col if w["id"] == focused_id), col[0])], out_h - gap - max(heights), True
    return col, out_h - gap - stacked_h, False


def geometry(width: int, snap: dict, view_x: float) -> dict:
    """Where everything goes, in whole pixels where it matters."""
    out, gap, cols, xs = snap["out"], snap["gap"], snap["cols"], snap["xs"]
    view_w, out_h = out["width"], out["height"]
    end = xs[-1] + col_width(cols[-1]) + gap if cols else view_w
    # The extent always takes in the snapshot's frame, so a slide never rescales.
    lo = min(-gap, snap["view_x"], view_x)
    hi = max(end, snap["view_x"] + view_w, view_x + view_w)
    s = min(MAX_SCALE, (width * MAX_W_FRAC - 2 * (PAD + FRAME_OUT)) / (hi - lo))
    # The frame maps the working area, not the whole output: waybar's strip
    # would otherwise leave more room above the tiles than below them.
    tops = [column_shape(c, gap, out_h, None)[1] for c in cols]
    area_top = max(0.0, min(tops) - gap) if tops else 0.0
    return {"lo": lo, "end": end, "s": s, "area_top": area_top,
            "strip_w": round((hi - lo) * s), "strip_h": round((out_h - area_top) * s)}


_cap: float | None = None


def cap_height() -> float:
    """Cap height of the name font: the header's optical height."""
    global _cap
    if _cap is None:
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, 8, 8)
        _cap = Text(cairo.Context(surf), "H", NAME_PX, bold=True).cap
    return _cap


def header_h() -> int:
    return round(cap_height())


def window_height(out: dict) -> int:
    body = round(out["height"] * MAX_SCALE) + 2 * FRAME_OUT
    return body + header_h() + HEADER_GAP + 2 * PAD + 2 * SHADOW


def draw(cr, width: int, height: int, snap: dict, alpha: float, view_x: float | None = None) -> None:
    cr.set_operator(cairo.OPERATOR_SOURCE)
    cr.set_source_rgba(0, 0, 0, 0)
    cr.paint()
    cr.set_operator(cairo.OPERATOR_OVER)
    if alpha <= 0:
        return

    out, gap, cols, xs = snap["out"], snap["gap"], snap["cols"], snap["xs"]
    view_w, out_h = out["width"], out["height"]
    if view_x is None:
        view_x = snap["view_x"]
    g = geometry(width, snap, view_x)
    lo, s, strip_w, strip_h, area_top = g["lo"], g["s"], g["strip_w"], g["strip_h"], g["area_top"]

    # Box model, outside in: card | PAD | outermost ink (the frame's outer
    # line edge, FRAME_OUT beyond the strip) | the strip the row is drawn in.
    card_w = strip_w + 2 * (FRAME_OUT + PAD)
    card_h = header_h() + HEADER_GAP + strip_h + 2 * FRAME_OUT + 2 * PAD
    # bottom-right, the shadow's room between the card and the screen edges
    cx = width - SHADOW - card_w
    cy = height - SHADOW - card_h
    content_l, content_r = cx + PAD, cx + card_w - PAD
    ox = content_l + FRAME_OUT  # strip left
    oy = cy + PAD + header_h() + HEADER_GAP + FRAME_OUT  # strip top

    def X(x: float) -> float:
        return ox + (x - lo) * s

    def Y(y: float) -> float:
        return oy + (y - area_top) * s

    # shadow: a stack of faint rounded rects, offset down a little
    steps = SHADOW // 2
    for i in range(steps, 0, -1):
        grow = i * 2
        rounded(cr, cx - grow, cy - grow + 6, card_w + 2 * grow, card_h + 2 * grow, CARD_R + grow)
        cr.set_source_rgba(0, 0, 0, 0.05 * alpha * (1 - i / (steps + 1)) ** 2)
        cr.fill()

    # card, with a hairline edge that catches the light
    rounded(cr, cx, cy, card_w, card_h, CARD_R)
    cr.set_source_rgba(*BG0_H, 0.96 * alpha)
    cr.fill()
    rounded(cr, cx + 0.5, cy + 0.5, card_w - 1, card_h - 1, CARD_R - 0.5)
    cr.set_line_width(1)
    cr.set_source_rgba(*FG, 0.08 * alpha)
    cr.stroke()

    # header: one baseline; cap tops sit exactly PAD below the card's edge
    baseline = cy + PAD + header_h()
    name = Text(cr, snap["name"], NAME_PX, bold=True)
    name.draw(cr, content_l, baseline, (*FG, alpha))
    left = sum(1 for x in xs if x < view_x - 0.5)
    right = sum(1 for c, x in zip(cols, xs) if x + col_width(c) > view_x + view_w + 0.5)
    if cols:
        Text(cr, f"{snap['active'] + 1} / {len(cols)}", META_PX).draw(
            cr, content_l + name.ink_w + 12, baseline, (*FG4, 0.9 * alpha)
        )
        r_txt = Text(cr, f"{right} ▶", META_PX, bold=right > 0)
        l_txt = Text(cr, f"◀ {left}", META_PX, bold=left > 0)
        r_x = content_r - r_txt.ink_w
        r_txt.draw(cr, r_x, baseline, (*(BRIGHT if right else GRAY), alpha))
        l_txt.draw(cr, r_x - 16 - l_txt.ink_w, baseline, (*(BRIGHT if left else GRAY), alpha))
    else:
        note = Text(cr, "empty", META_PX)
        note.draw(cr, content_r - note.ink_w, baseline, (*GRAY, alpha))

    # the row's track: the whole row, a faint lane the tiles sit in
    track_l, track_r = round(X(-gap)), round(X(g["end"]))
    track_t, track_b = oy, oy + strip_h
    rounded(cr, track_l, track_t, track_r - track_l, strip_h, FRAME_R)
    cr.set_source_rgba(*BG1, 0.40 * alpha)
    cr.fill()

    # tiles. Scaled, niri's 10px gap is under 2px, so tiles would touch; each
    # tile gives up GUTTER/2 on every side instead, which keeps the true
    # widths' proportions and a clean, equal seam everywhere.
    inset = max(GUTTER / 2, gap * s / 2)
    focused_id = snap["focused_id"]
    for col, x in zip(cols, xs):
        cw = col_width(col)
        shown, top, tabbed = column_shape(col, gap, out_h, focused_id)
        l, r = round(X(x - gap / 2) + inset), round(X(x + cw + gap / 2) - inset)
        y = top
        first_t = None
        for w in shown:
            wh = w["layout"]["tile_size"][1]
            t, b = round(Y(y - gap / 2) + inset), round(Y(y + wh + gap / 2) - inset)
            first_t = t if first_t is None else first_t
            draw_tile(cr, w, l, t, r - l, b - t, w["id"] == focused_id, alpha)
            y += wh + gap
        if tabbed:
            # one segment per tab just inside the top edge, like niri's tab strip
            n, seam = len(col), 2
            seg = (r - l - 2 * TABS_INSET - (n - 1) * seam) / n
            for i, w in enumerate(col):
                rounded(cr, l + TABS_INSET + i * (seg + seam), first_t + TABS_INSET, seg, 2, 1)
                cr.set_source_rgba(*(BRIGHT if w in shown else FG4), (0.9 if w in shown else 0.45) * alpha)
                cr.fill()

    # The frame box sits FRAME_OUT - 1 outside the screen's true edge, so its
    # 2px line clears the tiles by the same GUTTER the tiles keep between them.
    e = FRAME_OUT - 1
    fx0, fx1 = round(X(view_x)) - e, round(X(view_x + view_w)) + e
    fy0, fy1 = track_t - e, track_b + e
    frame_r = FRAME_R + e

    # everything off screen sinks back: dim the track outside the frame
    cr.save()
    rounded(cr, track_l, track_t, track_r - track_l, strip_h, FRAME_R)
    cr.clip()
    cr.rectangle(track_l, track_t, track_r - track_l, strip_h)
    rounded(cr, fx0, fy0, fx1 - fx0, fy1 - fy0, frame_r)
    cr.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)
    cr.set_source_rgba(*BG0_H, 0.66 * alpha)
    cr.fill()
    cr.restore()

    # the frame: a soft glow, then a crisp 2px line
    for lw, a in ((8, 0.06), (5, 0.12)):
        rounded(cr, fx0, fy0, fx1 - fx0, fy1 - fy0, frame_r)
        cr.set_line_width(lw)
        cr.set_source_rgba(*BRIGHT, a * alpha)
        cr.stroke()
    rounded(cr, fx0, fy0, fx1 - fx0, fy1 - fy0, frame_r)
    cr.set_line_width(2)
    cr.set_source_rgba(*BRIGHT, 0.95 * alpha)
    cr.stroke()


# ---- daemon --------------------------------------------------------------------


def now_ms() -> float:
    return GLib.get_monotonic_time() / 1000


def ease_out(t: float) -> float:
    t = min(1.0, max(0.0, t))
    return 1 - (1 - t) ** 3


class Minimap:
    def __init__(self) -> None:
        self.snap: dict | None = None
        self.last_ws = None
        # The GdkMonitor the layer surface is bound to. Not its position: when an
        # output goes away, the one left often moves to the same (0, 0).
        self.monitor = None
        self.overview = False
        self.primed = False  # ignore the burst of state niri sends on connect
        self.visible = False
        self.hide_id = 0
        self.tick_id = 0
        # animation: alpha goes a0 -> a1 from t_a over dur_a; the frame x0 -> x1 from t_x
        self.a0 = self.a1 = 0.0
        self.t_a, self.dur_a = 0.0, 1.0
        self.x0 = self.x1 = 0.0
        self.t_x = 0.0

        self.win = Gtk.Window()
        self.win.set_app_paintable(True)
        visual = self.win.get_screen().get_rgba_visual()
        if visual is not None:
            self.win.set_visual(visual)
        GtkLayerShell.init_for_window(self.win)
        GtkLayerShell.set_namespace(self.win, "niri-minimap")
        GtkLayerShell.set_layer(self.win, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_keyboard_mode(self.win, GtkLayerShell.KeyboardMode.NONE)
        GtkLayerShell.set_exclusive_zone(self.win, 0)  # stays clear of waybar's zone
        GtkLayerShell.set_anchor(self.win, GtkLayerShell.Edge.LEFT, True)
        GtkLayerShell.set_anchor(self.win, GtkLayerShell.Edge.RIGHT, True)
        GtkLayerShell.set_anchor(self.win, GtkLayerShell.Edge.BOTTOM, True)
        self.win.connect("draw", self.on_draw)
        # An empty input region: the pointer goes straight through to the windows.
        self.win.connect("realize", lambda w: w.input_shape_combine_region(cairo.Region()))
        # The compositor closes the surface with its output; map it afresh next time.
        Gdk.Display.get_default().connect("monitor-removed", self.on_monitor_removed)

    def on_monitor_removed(self, display, monitor) -> None:
        if monitor == self.monitor:
            self.win.hide()
            self.visible = False
            self.monitor = None

    # -- animation

    def alpha(self) -> float:
        return self.a0 + (self.a1 - self.a0) * ease_out((now_ms() - self.t_a) / self.dur_a)

    def frame_x(self) -> float:
        return self.x0 + (self.x1 - self.x0) * ease_out((now_ms() - self.t_x) / SLIDE_MS)

    def fade_to(self, target: float, dur: float) -> None:
        self.a0, self.a1, self.t_a, self.dur_a = self.alpha(), target, now_ms(), dur
        self.animate()

    def animate(self) -> None:
        if not self.tick_id:
            self.tick_id = GLib.timeout_add(16, self.tick)

    def tick(self) -> bool:
        t = now_ms()
        self.win.queue_draw()
        if t - self.t_a < self.dur_a or t - self.t_x < SLIDE_MS:
            return True
        self.tick_id = 0
        if self.a1 <= 0:
            self.visible = False
            self.win.hide()
        return False

    def on_draw(self, widget, cr) -> bool:
        if self.snap:
            alloc = widget.get_allocation()
            draw(cr, alloc.width, alloc.height, self.snap, self.alpha(), self.frame_x())
        return True

    # -- showing

    def monitor_for(self, out: dict):
        display = Gdk.Display.get_default()
        for i in range(display.get_n_monitors()):
            m = display.get_monitor(i)
            g = m.get_geometry()
            if (g.x, g.y) == (out["x"], out["y"]):
                return m
        return None

    def show(self, snap: dict) -> None:
        """Bring the map up (or keep it up) for SHOW_MS."""
        out = snap["out"]
        monitor = self.monitor_for(out)
        if monitor is None or monitor != self.monitor:
            # A layer surface picks its output when it maps: remap to move it.
            self.win.hide()
            self.visible = False
            GtkLayerShell.set_monitor(self.win, monitor)
            self.monitor = monitor
        self.win.set_size_request(-1, window_height(out))
        if not self.visible:
            self.a0 = self.a1 = 0.0
        self.set_snap(snap, slide=False)
        self.visible = True
        self.win.show_all()
        self.fade_to(1.0, FADE_IN_MS)
        if self.hide_id:
            GLib.source_remove(self.hide_id)
        self.hide_id = GLib.timeout_add(SHOW_MS, self.start_fade)

    def set_snap(self, snap: dict, slide: bool) -> None:
        if slide:
            self.x0, self.x1, self.t_x = self.frame_x(), snap["view_x"], now_ms()
        else:
            self.x0 = self.x1 = snap["view_x"]
            self.t_x = 0.0
        self.snap = snap
        self.animate()

    def start_fade(self) -> bool:
        self.hide_id = 0
        self.fade_to(0.0, FADE_OUT_MS)
        return False

    def show_now(self) -> bool:
        ws = focused_workspace()
        snap = snapshot(ws["id"]) if ws else None
        if snap:
            self.show(snap)
        return True

    def after_event(self) -> None:
        for ws_id in workspaces:
            update_view(ws_id)
        ws = focused_workspace()
        snap = snapshot(ws["id"]) if ws else None
        ws_id = snap["ws_id"] if snap else None
        switched = ws_id != self.last_ws
        self.last_ws = ws_id
        if snap is None:
            return
        if switched:
            # Only a workspace switch brings it up (an empty workspace needs no map).
            if self.primed and not self.overview and snap["cols"]:
                self.show(snap)
            elif self.visible:
                self.start_fade()
        elif self.visible and self.a1 > 0:
            # Already up on this workspace: follow it, without extending its time.
            self.set_snap(snap, slide=True)

    def handle(self, ev: dict) -> None:
        for kind, data in ev.items():
            if kind == "WindowsChanged":
                windows.clear()
                windows.update({w["id"]: w for w in data["windows"]})
            elif kind == "WindowOpenedOrChanged":
                w = data["window"]
                windows[w["id"]] = w
                if w.get("is_focused"):
                    for other in windows.values():
                        other["is_focused"] = other["id"] == w["id"]
            elif kind == "WindowClosed":
                windows.pop(data["id"], None)
            elif kind == "WindowFocusChanged":
                for w in windows.values():
                    w["is_focused"] = w["id"] == data.get("id")
            elif kind == "WindowLayoutsChanged":
                for wid, layout in data["changes"]:
                    if wid in windows:
                        windows[wid]["layout"] = layout
            elif kind == "WorkspacesChanged":
                workspaces.clear()
                workspaces.update({w["id"]: w for w in data["workspaces"]})
                read_outputs()
            elif kind == "WorkspaceActivated":
                target = workspaces.get(data["id"])
                if target:
                    for w in workspaces.values():
                        if w.get("output") == target.get("output"):
                            w["is_active"] = w["id"] == data["id"]
                        if data.get("focused"):
                            w["is_focused"] = w["id"] == data["id"]
            elif kind == "WorkspaceActiveWindowChanged":
                if data["workspace_id"] in workspaces:
                    workspaces[data["workspace_id"]]["active_window_id"] = data["active_window_id"]
            elif kind == "OverviewOpenedOrClosed":
                self.overview = data["is_open"]
                if self.overview and self.visible:
                    self.start_fade()
                continue
            else:
                continue
            self.after_event()

    def run(self) -> int:
        read_outputs()
        proc = Gio.Subprocess.new(
            ["niri", "msg", "-j", "event-stream"], Gio.SubprocessFlags.STDOUT_PIPE
        )
        stream = Gio.DataInputStream.new(proc.get_stdout_pipe())

        def on_line(src, res) -> None:
            line, _ = src.read_line_finish_utf8(res)
            if line is None:  # niri went away
                Gtk.main_quit()
                return
            line = line.strip()
            if line:
                try:
                    self.handle(json.loads(line))
                except (json.JSONDecodeError, KeyError, TypeError):
                    pass
            src.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)
        GLib.timeout_add(600, self.prime)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self.show_now)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda: Gtk.main_quit() or False)
        Gtk.main()
        proc.force_exit()
        return 0

    def prime(self) -> bool:
        self.primed = True
        return False


def focused_workspace() -> dict | None:
    return next((w for w in workspaces.values() if w.get("is_focused")), None)


def running_pid() -> int | None:
    try:
        with open(PIDFILE) as f:
            pid = int(f.read().strip())
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            if b"niri-minimap" in f.read():
                return pid
    except (OSError, ValueError):
        pass
    return None


def render_png(path: str, name: str | None) -> int:
    """One-shot drawing of a workspace, for checking the look."""
    read_outputs()
    workspaces.update({w["id"]: w for w in niri_json("workspaces") or []})
    windows.update({w["id"]: w for w in niri_json("windows") or []})
    for ws_id in workspaces:
        update_view(ws_id)
    if name is None:
        ws = focused_workspace()
    else:
        ws = next((w for w in workspaces.values() if (w.get("name") or str(w["idx"])) == name), None)
    snap = snapshot(ws["id"]) if ws else None
    if not snap:
        print(f"no workspace {name or '(focused)'}", file=sys.stderr)
        return 1
    w, h = int(snap["out"]["width"]), window_height(snap["out"])
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
    draw(cairo.Context(surface), w, h, snap, 1.0)
    surface.write_to_png(path)
    print(path)
    return 0


def main() -> int:
    args = sys.argv[1:]
    if args[:1] == ["--show"]:
        pid = running_pid()
        if pid is None:
            print("niri-minimap is not running", file=sys.stderr)
            return 1
        os.kill(pid, signal.SIGUSR1)
        return 0
    if args[:1] == ["--png"] and len(args) in (2, 3):
        return render_png(args[1], args[2] if len(args) == 3 else None)
    if args:
        print(__doc__, file=sys.stderr)
        return 2

    old = running_pid()
    if old is not None and old != os.getpid():
        os.kill(old, signal.SIGTERM)
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))
    return Minimap().run()


if __name__ == "__main__":
    sys.exit(main())
