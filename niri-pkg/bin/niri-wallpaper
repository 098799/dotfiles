#!/usr/bin/env -S python3 -I
"""The Wayland half of `theme`'s wallpaper, with a frosted band where the bar is.

`theme` (through wallpaper-pick) writes ~/.fehbg with the current image; feh cannot
paint a Wayland root, so this hands the image to swaybg. Restarts the previous
swaybg, so it is safe to call after every theme change.

The band: the bar is transparent, with floating pills (~/.config/waybar). On a busy
wallpaper (gruvbox-dark-20's fractal) every gap between the pills showed sharp
detail, and the bar looked broken into pieces. niri 26.04 cannot blur behind a
layer surface, but the bar never moves, so the blur is baked into the picture:
the top BAND logical px are blurred and tinted toward the theme's background, and
fade into the image over FADE px. Done per output at its exact pixel size (swaybg
scales the same image differently per screen), cached in ~/.cache/niri-wallpaper.
Other outputs get the plain image. ~/.fehbg and niri-lock keep the plain one.

    niri-wallpaper            set the wallpaper (what wallpaper-pick and bardeck call)
    niri-wallpaper --plain    without the band
"""
import glob
import hashlib
import json
import os
import pwd
import re
import subprocess
import sys

HOME = pwd.getpwuid(os.getuid()).pw_dir
CACHE = f"{HOME}/.cache/niri-wallpaper"
VERSION = 1
# Logical px: the bar's 3 px margin + its height (config.jsonc: 28 on the laptop's
# eDP, 36 elsewhere) + a little air.
BAND = {"eDP": 35, "*": 43}
FADE = 22        # logical px of fade below the band
BLUR = 9         # logical px blur radius
TINT = {"dark": 0.42, "light": 0.30}  # how far toward the theme background
KEEP = 24        # cached pictures to keep


def wallpaper() -> str | None:
    try:
        src = open(f"{HOME}/.fehbg").read()
    except OSError:
        return None
    found = re.findall(r"/[^ ']+\.(?:png|jpg|jpeg|webp)", src)
    return found[-1] if found else None


def theme_of(path: str) -> tuple[str, str]:
    """(mode, palette) from the file name (gruvbox-light-3.png). `theme` writes its
    state file only after it picked the wallpaper, so the state can be the old one."""
    m = re.match(r"(gruvbox|selenized|solarized)-(dark|light)", os.path.basename(path))
    if m:
        return m.group(2), m.group(1)
    try:
        mode, palette = open(f"{HOME}/.config/theme/state").read().split()[:2]
        return mode, palette
    except (OSError, ValueError):
        return "dark", "gruvbox"


def background(mode: str, palette: str) -> tuple[int, int, int]:
    """The theme's bg_main, from the colors.d file i3 and the bar use."""
    try:
        for line in open(f"{HOME}/.config/i3/colors.d/{palette}-{mode}.conf"):
            p = line.split()
            if len(p) >= 3 and p[:2] == ["set", "$bg_main"]:
                h = p[2]
                return int(h[1:3], 16), int(h[3:5], 16), int(h[5:7], 16)
    except OSError:
        pass
    return (40, 40, 40) if mode == "dark" else (251, 241, 199)


def outputs() -> dict:
    try:
        out = json.loads(subprocess.run(["niri", "msg", "-j", "outputs"], capture_output=True,
                                        text=True, timeout=3).stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return {}
    res = {}
    for name, o in out.items():
        mode_i, logical = o.get("current_mode"), o.get("logical")
        if mode_i is None or not logical:
            continue
        m = o["modes"][mode_i]
        w, h = m["width"], m["height"]
        if logical.get("transform", "Normal") in ("90", "270", "Flipped90", "Flipped270"):
            w, h = h, w
        res[name] = (w, h, float(logical.get("scale") or 1))
    return res


def band_of(output: str) -> int:
    return BAND["eDP"] if output.startswith("eDP") else BAND["*"]


def banded(path: str, w: int, h: int, scale: float, band_lp: int) -> str:
    """The wallpaper as swaybg's "fill" would show it on a w×h screen, with the band."""
    mode, palette = theme_of(path)
    bg = background(mode, palette)
    st = os.stat(path)
    key = hashlib.sha1(repr((VERSION, path, st.st_mtime, st.st_size, w, h, scale, bg,
                             band_lp, FADE, BLUR, TINT[mode])).encode()).hexdigest()[:16]
    out = f"{CACHE}/{key}.png"
    if os.path.exists(out):
        return out
    from PIL import Image, ImageFilter

    img = Image.open(path).convert("RGB")
    # swaybg's fill: cover the screen, centred, cropped.
    k = max(w / img.width, h / img.height)
    img = img.resize((max(w, round(img.width * k)), max(h, round(img.height * k))), Image.LANCZOS)
    left, top = (img.width - w) // 2, (img.height - h) // 2
    img = img.crop((left, top, left + w, top + h))
    band, fade, blur = round(band_lp * scale), round(FADE * scale), BLUR * scale
    region = img.crop((0, 0, w, band + fade + round(blur * 3)))
    frosted = region.filter(ImageFilter.GaussianBlur(blur))
    frosted = Image.blend(frosted, Image.new("RGB", frosted.size, bg), TINT[mode])
    mask = Image.new("L", frosted.size, 0)
    for y in range(frosted.height):
        a = 1.0 if y < band else max(0.0, 1 - (y - band) / fade)
        a = a * a * (3 - 2 * a)  # smoothstep: no visible edge where the fade ends
        mask.paste(round(255 * a), (0, y, w, y + 1))
    img.paste(frosted, (0, 0), mask)
    os.makedirs(CACHE, exist_ok=True)
    img.save(f"{out}.tmp.png", compress_level=1)
    os.replace(f"{out}.tmp.png", out)
    old = sorted(glob.glob(f"{CACHE}/*.png"), key=os.path.getmtime)[:-KEEP]
    for f in old:
        os.unlink(f)
    return out


def main() -> int:
    wp = wallpaper()
    if not wp:
        return 0
    args = ["swaybg", "-o", "*", "-i", wp, "-m", "fill"]
    if "--plain" not in sys.argv:
        for name, (w, h, scale) in outputs().items():
            try:
                args += ["-o", name, "-i", banded(wp, w, h, scale, band_of(name)), "-m", "stretch"]
            except Exception as err:  # a broken image: that output keeps the plain one
                print(f"niri-wallpaper: {name}: {err!r}", file=sys.stderr)
    subprocess.run(["pkill", "-x", "swaybg"], check=False)
    os.execvp("swaybg", args)


if __name__ == "__main__":
    sys.exit(main())
