#!/usr/bin/env python3
"""quota-deck — the Claude quotas on waybar as small week charts, and a drop-down deck.

The bar used to show each account's 5h window only ("W:4%(4h46m) P:14% …"). The
weekly budget is the one that runs out now, so this draws, for every account, a
tiny version of qtop's week chart right in the bar:

    W [▁▂▄▆ ╱ ┊ ‥]▮ 33     one cell per account
       │    │  │  │  └ weekly %, in the verdict's colour
       │    │  │  └── the 5h window, as a tank (red at 100%, yellow over burn's ceiling)
       │    │  └───── projection from the last 24 h to the reset
       │    └──────── even pace to 95% at the reset (the line to stay near)
       └───────────── this quota week's usage, Mon … reset

    colour = qtop's verdict: green lands well, yellow wastes points, red hits 100%
    early. The active account (right-click to switch) is underlined.

Hover the strip and the deck opens: every account's week at full size (usage, pace,
projection, the 5h peaks under it against burn's ceiling), and the pool totals. It
closes when the pointer leaves the strip and the deck. A click pins it open (Esc or a
click outside closes it). The strip is a waybar CFFI module,
~/.config/waybar/quota-hover.c: waybar has no hover action, and a GTK3 tooltip waits
~500 ms.

All numbers and verdicts come from qtop (~/bin/qtop, imported, not copied), which
reads rcmon's usage federation files. Nothing here asks Anthropic.

Usage:
    quota-deck daemon            render the strip and hold the deck; waybar starts it (custom/quota-daemon)
    quota-deck deck              open the deck without the daemon (slow: ~1.5 s cold)
    pkill -USR1 -x quota-deck    pin / close the deck the daemon holds (what a click does)
    quota-deck strip FILE [--compact] [--scale N]   draw the strip to a PNG, for testing
    quota-deck deck-png FILE [--scale N]            draw the deck to a PNG, for testing

Why a daemon: it draws the strip PNGs off waybar's main thread (quota-hover.so only
loads them, on SIGRTMIN+SIGNAL), and it holds the deck, hidden and drawn ahead, so
an opening costs ~20 ms: see Deck. quota-hover.so sends it "enter" / "leave" /
"click" on the datagram socket $XDG_RUNTIME_DIR/quota-deck/ctl; SIGUSR1 is a click.
"""

from __future__ import annotations

import contextlib
import ctypes
import fcntl
import importlib.machinery
import importlib.util
import math
import os
import pwd
import shutil
import signal
import socket
import subprocess
import sys
import time
from datetime import datetime, timedelta

import cairo
import gi

gi.require_version("Pango", "1.0")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Pango, PangoCairo  # noqa: E402

REAL_HOME = pwd.getpwuid(os.getuid()).pw_dir  # agent shells run with a fake $HOME
ACCOUNT_FILE = f"{REAL_HOME}/.config/claude-active-account"
# QUOTA_DECK_TRACE=1: print when the deck is asked for and when it is on screen (stderr).
TRACE = bool(os.environ.get("QUOTA_DECK_TRACE"))
RUN_DIR = f"{os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'}/quota-deck"
# The image modules' "signal" in modules.jsonc.
SIGNAL = 16
BAR_HEIGHT = 22  # waybar's height (config.jsonc), as in ~/bin/barmenu
FONT = "Ubuntu Mono"

# gruvbox-dark, as in waybar/style.css.
PALETTE = {
    "bg": "#282828", "alt": "#3c3836", "sep": "#504945", "fg": "#a89984", "dim": "#7c6f64",
    "title": "#ebdbb2", "ok": "#b8bb26", "warn": "#fabd2f", "hit": "#fb4934",
    "pace": "#83a598", "accent": "#98971a", "max": "#d3869b", "team": "#83a598",
}


def rgba(name: str, alpha: float = 1.0) -> tuple[float, float, float, float]:
    h = PALETTE.get(name, name)
    return int(h[1:3], 16) / 255, int(h[3:5], 16) / 255, int(h[5:7], 16) / 255, alpha


def load_qtop():
    """qtop's model (Store, Week, verdicts), imported from the script itself."""
    path = shutil.which("qtop") or f"{REAL_HOME}/bin/qtop"
    loader = importlib.machinery.SourceFileLoader("qtop", path)
    spec = importlib.util.spec_from_loader("qtop", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


Q = load_qtop()


# ── state: one account as the pictures need it ───────────────────────────────


class Row:
    """One account now: its week (or a past one), its 5h window, and how to say it."""

    def __init__(self, m, account: str, active: str, now: float, back: int = 0):
        self.account = account
        self.label = Q.LETTER.get(account, account[:2].upper())
        self.active = account == active
        self.pool = Q.pool_of(account)
        self.week, self.back, self.weeks = m.week_of(account, back)
        last = m.store.last(account)
        self.stale = last is None or now - last.t > Q.STALE_S
        self.five_live = bool(last and last.r5 and last.r5 > now and not self.stale)
        self.u5 = (last.u5 or 0.0) if self.five_live else 0.0
        self.r5 = (last.r5 - now) if self.five_live else None
        if self.week is None:
            self.verdict, self.tone = "no readings", "dim"
        else:
            self.verdict, self.tone = Q.week_verdict(self.week, now)
        if self.stale and back == 0:
            why = m.why(account)
            age = Q.ago(now - last.t) if last else "ever"
            self.verdict, self.tone = (f"{why} · {age}" if why else f"no reading for {age}"), "dim"
        # "over" = the week in the log has reset and no reading of the new one came yet.
        self.over = self.week is None or (back == 0 and self.week.over(now))

    @property
    def colour(self) -> str:
        return self.tone if self.tone in ("ok", "warn", "hit") else "dim"

    def five_colour(self) -> str:
        if self.u5 >= 100:
            return "hit"
        return "warn" if self.u5 >= Q.CEILING[self.pool] else "fg"


def rows(m, now: float, back: int = 0) -> list[Row]:
    active = read_active()
    return [Row(m, a, active, now, back) for a in m.accounts()]


def read_active() -> str:
    try:
        with open(ACCOUNT_FILE) as fh:
            return fh.read().strip()
    except OSError:
        return "work"


# ── drawing primitives ───────────────────────────────────────────────────────


def text(cr, x: float, y: float, s: str, size: float, colour, *, bold: bool = False,
         align: float = 0.0, markup: bool = False) -> float:
    """Draw s with its top-left at (x, y) (align 0.5 centres, 1 right-aligns); return its width."""
    layout = PangoCairo.create_layout(cr)
    desc = Pango.FontDescription.from_string(f"{FONT} {'Bold' if bold else ''}")
    desc.set_absolute_size(size * Pango.SCALE)
    layout.set_font_description(desc)
    if markup:
        layout.set_markup(s, -1)
    else:
        layout.set_text(s, -1)
    w, _ = layout.get_pixel_size()
    cr.move_to(x - w * align, y)
    cr.set_source_rgba(*(rgba(colour) if isinstance(colour, str) else colour))
    PangoCairo.show_layout(cr, layout)
    return w


def text_width(cr, s: str, size: float, bold: bool = False) -> float:
    layout = PangoCairo.create_layout(cr)
    desc = Pango.FontDescription.from_string(f"{FONT} {'Bold' if bold else ''}")
    desc.set_absolute_size(size * Pango.SCALE)
    layout.set_font_description(desc)
    layout.set_text(s, -1)
    return layout.get_pixel_size()[0]


def rrect(cr, x, y, w, h, r) -> None:
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def week_chart(cr, x: float, y: float, w: float, h: float, row: Row, now: float, *,
               detail: bool) -> None:
    """qtop's week chart drawn with cairo: usage area, even pace, projection, now.

    detail=False is the bar's thumbnail: no labels, the lines only. detail=True adds
    the day bands, the 50% and target rules, and the end labels."""
    wk = row.week
    cr.save()
    rrect(cr, x, y, w, h, 2 if detail else 1.5)
    cr.set_source_rgba(*rgba("alt" if detail else "bg"))
    cr.fill_preserve()
    cr.clip()
    if wk is None:
        cr.restore()
        return

    def X(t: float) -> float:
        return x + (t - wk.start) / Q.WEEK * w

    def Y(v: float) -> float:
        return y + h - max(0.0, min(100.0, v)) / 100 * h

    if detail:
        # Alternate day bands, from local midnight.
        day = datetime.fromtimestamp(wk.start).replace(hour=0, minute=0, second=0, microsecond=0)
        i = 0
        while day.timestamp() < wk.reset:
            if i % 2:
                a, b = X(day.timestamp()), X((day + timedelta(days=1)).timestamp())
                cr.rectangle(a, y, b - a, h)
                cr.set_source_rgba(*rgba("bg", 0.35))
                cr.fill()
            day += timedelta(days=1)
            i += 1
        cr.set_line_width(1)
        cr.set_source_rgba(*rgba("sep"))
        for v in (25, 50, 75):
            cr.move_to(x, round(Y(v)) + 0.5)
            cr.line_to(x + w, round(Y(v)) + 0.5)
        cr.set_dash([1, 3])
        cr.stroke()
        cr.set_dash([])

    tone = row.colour if not row.over else "dim"
    pts = [(X(t), Y(v)) for t, v in wk.points]

    # Even pace to TARGET at the reset.
    cr.set_line_width(1.0 if detail else 0.8)
    cr.set_source_rgba(*rgba("pace", 0.9 if detail else 0.75))
    cr.set_dash([3, 3] if detail else [1.5, 1.5])
    cr.move_to(X(wk.start), Y(0))
    cr.line_to(X(wk.reset), Y(Q.TARGET))
    cr.stroke()
    cr.set_dash([])

    if pts:
        # Area under the usage line, then the line.
        cr.move_to(pts[0][0], y + h)
        for px, py in pts:
            cr.line_to(px, py)
        cr.line_to(pts[-1][0], y + h)
        cr.close_path()
        grad = cairo.LinearGradient(0, y, 0, y + h)
        grad.add_color_stop_rgba(0, *rgba(tone, 0.55)[:3], 0.55)
        grad.add_color_stop_rgba(1, *rgba(tone, 0.15)[:3], 0.15)
        cr.set_source(grad)
        cr.fill()
        cr.move_to(*pts[0])
        for p in pts[1:]:
            cr.line_to(*p)
        cr.set_source_rgba(*rgba(tone))
        cr.set_line_width(1.5 if detail else 1.2)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        cr.stroke()

        # Projection from the last 24 h: to 100% and flat from there when it walls.
        proj = wk.projected(now) if row.back == 0 else None
        if proj is not None:
            full = wk.full_at(now)
            cr.move_to(*pts[-1])
            if full is not None:
                cr.line_to(X(full), Y(100))
                cr.line_to(X(wk.reset), Y(100))
            else:
                cr.line_to(X(wk.reset), Y(proj))
            cr.set_source_rgba(*rgba(tone, 0.85))
            cr.set_line_width(1.0)
            cr.set_dash([2, 2] if detail else [1.2, 1.2])
            cr.stroke()
            cr.set_dash([])
            if full is not None:
                cr.arc(X(full), Y(100) + (3 if detail else 1.2), 3 if detail else 1.4, 0, 2 * math.pi)
                cr.set_source_rgba(*rgba("hit"))
                cr.fill()

    # Now.
    if row.back == 0 and wk.start < now < wk.reset:
        cr.move_to(round(X(now)) + 0.5, y)
        cr.line_to(round(X(now)) + 0.5, y + h)
        cr.set_source_rgba(*rgba("title", 0.45 if detail else 0.35))
        cr.set_line_width(1)
        cr.stroke()
    cr.restore()


def peaks_chart(cr, x: float, y: float, w: float, h: float, row: Row) -> None:
    """The 5h windows of the week, one bar per window, against burn's ceiling."""
    wk = row.week
    if wk is None:
        return
    ceiling = Q.CEILING[row.pool]

    def X(t: float) -> float:
        return x + (t - wk.start) / Q.WEEK * w

    for end, peak in wk.windows:
        a, b = X(end - 5 * 3600), X(end)
        a, b = max(a, x), min(b, x + w)
        if b <= a:
            continue
        bh = max(1.0, min(100.0, peak) / 100 * h)
        cr.rectangle(a + 0.5, y + h - bh, max(1.0, b - a - 1), bh)
        colour = "hit" if peak >= 100 else ("warn" if peak >= ceiling else "fg")
        cr.set_source_rgba(*rgba(colour, 0.9 if colour != "fg" else 0.55))
        cr.fill()
    cy = round(y + h - ceiling / 100 * h) + 0.5
    cr.move_to(x, cy)
    cr.line_to(x + w, cy)
    cr.set_source_rgba(*rgba("warn", 0.5))
    cr.set_line_width(1)
    cr.set_dash([2, 3])
    cr.stroke()
    cr.set_dash([])


# ── the strip (the bar) ──────────────────────────────────────────────────────

# Each strip has a FIXED width, and it must equal the image module's "size" in
# modules.jsonc: waybar fits the image into a size x size box, so a narrower size
# shrinks the strip and a wider one blows it up (and the bar with it). The charts
# take whatever width the labels leave.
STRIP = {
    "full": {"width": 560, "pct": True},
    "compact": {"width": 330, "pct": False},
}


def strip_layout(cr, rs: list[Row], mode: str) -> tuple[list[tuple[Row, float, float]], float]:
    """(row, x, width) per cell, and the chart width that fills the strip."""
    spec = STRIP[mode]
    gap, edge = 9.0, 4.0
    fixed = [text_width(cr, r.label, 13, bold=True) + 3 + 2 + 3
             + (3 + text_width(cr, "100", 13) if spec["pct"] else 0) for r in rs]
    chart = max(12.0, (spec["width"] - 2 * edge - gap * (len(rs) - 1) - sum(fixed)) / max(1, len(rs)))
    out, x = [], edge
    for r, f in zip(rs, fixed):
        out.append((r, x, f + chart))
        x += f + chart + gap
    return out, chart


def draw_strip(path: str, rs: list[Row], now: float, mode: str, scale: int) -> None:
    probe = cairo.Context(cairo.ImageSurface(cairo.FORMAT_ARGB32, 1, 1))
    cells, chart = strip_layout(probe, rs, mode)
    width = STRIP[mode]["width"]
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, width * scale, BAR_HEIGHT * scale)
    cr = cairo.Context(surface)
    cr.scale(scale, scale)
    spec = STRIP[mode]
    top, ch = 3.0, BAR_HEIGHT - 6.0
    # The block rule every bar block has on its left (style.css): the module is a CFFI
    # widget that waybar's CSS does not reach, so the image carries its own.
    cr.rectangle(0, 0, 1, BAR_HEIGHT)
    cr.set_source_rgba(*rgba("sep"))
    cr.fill()
    for r, x, w in cells:
        dim = r.over or r.stale
        lw = text(cr, x, 3, r.label, 13, "title" if r.active else ("dim" if dim else "fg"), bold=r.active)
        cx = x + lw + 3
        week_chart(cr, cx, top, chart, ch, r, now, detail=False)
        if dim:
            text(cr, cx + chart / 2, 3, "?", 13, "dim", align=0.5)
        # 5h tank.
        tx = cx + chart + 2
        cr.rectangle(tx, top, 3, ch)
        cr.set_source_rgba(*rgba("alt"))
        cr.fill()
        if r.five_live and r.u5 > 0:
            th = max(1.0, min(100.0, r.u5) / 100 * ch)
            cr.rectangle(tx, top + ch - th, 3, th)
            # Blue under the ceiling, so the tank never reads as a weekly verdict colour.
            cr.set_source_rgba(*rgba("pace" if r.five_colour() == "fg" else r.five_colour()))
            cr.fill()
        if spec["pct"]:
            pct = "?" if dim else f"{r.week.used:.0f}"
            text(cr, tx + 6, 3, pct, 13, "dim" if dim else r.colour, bold=r.active)
        if r.active:
            cr.rectangle(x, BAR_HEIGHT - 2, w, 2)
            cr.set_source_rgba(*rgba("accent"))
            cr.fill()
    tmp = f"{path}.tmp"
    surface.write_to_png(tmp)
    os.replace(tmp, path)


# ── the deck (the drop-down) ─────────────────────────────────────────────────

DECK_W = 860
HEAD_H = 46
CARD_H = 112
FOOT_H = 26
INFO_W = 230
PAD = 14


def deck_size(n: int) -> tuple[int, int]:
    return DECK_W, HEAD_H + n * CARD_H + FOOT_H


def draw_deck(cr, m, now: float, back: int, sel: int) -> list[tuple[str, float, float]]:
    """Draw the deck at (0, 0). Returns (account, y0, y1) per card, for clicks."""
    rs = rows(m, now, back)
    w, h = deck_size(len(rs))
    rrect(cr, 0.5, 0.5, w - 1, h - 1, 6)
    cr.set_source_rgba(*rgba("bg", 0.97))
    cr.fill_preserve()
    cr.set_source_rgba(*rgba("sep"))
    cr.set_line_width(1)
    cr.stroke()

    # Header: title, freshness, federation, clock; the pools under it.
    x = text(cr, PAD, 8, "Claude quota", 16, "title", bold=True) + PAD + 10
    newest = m.store.newest()
    fresh = now - newest
    dot = "ok" if fresh < 300 else ("warn" if fresh < Q.STALE_S else "hit")
    x += text(cr, x, 10, "●", 13, dot) + 4
    x += text(cr, x, 10, f"sample {Q.ago(fresh)} ago" if newest else "no samples", 13, "dim") + 12
    fed = m.fed()
    if not fed or now - float(fed.get("updated_at") or 0) > Q.FED_DOWN_S:
        text(cr, x, 10, "federation silent — is rcmon running?", 13, "hit")
    else:
        peers = fed.get("peers") or {}
        bad = [n for n, p in peers.items()
               if p.get("error") or not p.get("pulled_at") or now - p["pulled_at"] > 300]
        x += text(cr, x, 10, "fed ", 13, "dim")
        x += text(cr, x, 10, "●", 13, "warn" if bad else "ok") + 4
        text(cr, x, 10, " ".join(f"{n}{'✗' if n in bad else '✓'}" for n in peers), 13, "dim")
    stamp = datetime.fromtimestamp(now).strftime("%a %d %b %H:%M")
    if back:
        stamp = f"{back} week{'s' if back > 1 else ''} back · " + stamp
    text(cr, w - PAD, 10, stamp, 13, "warn" if back else "dim", align=1)
    pools = "".join(t for t, _ in Q.pool_summary(m, now)).strip()
    text(cr, PAD, 27, pools or " ", 12, "fg")

    hits = []
    for i, r in enumerate(rs):
        y0 = HEAD_H + i * CARD_H
        hits.append((r.account, y0, y0 + CARD_H))
        cr.move_to(PAD, y0 + 0.5)
        cr.line_to(w - PAD, y0 + 0.5)
        cr.set_source_rgba(*rgba("sep", 0.7))
        cr.set_line_width(1)
        cr.stroke()
        if i == sel:
            cr.rectangle(1, y0 + 1, w - 2, CARD_H - 1)
            cr.set_source_rgba(*rgba("alt", 0.45))
            cr.fill()
        if r.active:
            cr.rectangle(1, y0 + 8, 3, CARD_H - 16)
            cr.set_source_rgba(*rgba("accent"))
            cr.fill()
        draw_card(cr, r, now, PAD, y0 + 8, w - 2 * PAD, CARD_H - 16)

    hint = "click a card or Enter: qtop on it · i/o select · u/p earlier/later week · esc closes"
    text(cr, w / 2, h - FOOT_H + 5, hint, 12, "dim", align=0.5)
    return hits


def draw_card(cr, r: Row, now: float, x: float, y: float, w: float, h: float) -> None:
    # Info column.
    lw = text(cr, x + 4, y - 2, r.label, 22, "title" if r.active else "fg", bold=True)
    name = r.account + (f" · {Q.ALIAS[r.account]}" if r.account in Q.ALIAS else "")
    text(cr, x + 12 + lw, y + 1, name, 14, "title")
    pool_x = x + 12 + lw
    text(cr, pool_x, y + 17, r.pool + (" · active" if r.active else ""), 12, "max" if r.pool == "max" else "team")

    wk = r.week
    if wk is not None and not r.over:
        big = text(cr, x + 4, y + 34, f"{wk.used:.0f}%", 26, r.colour, bold=True)
        sub = f"week {Q.when(wk.start, now)} → {Q.when(wk.reset, now)}" if r.back else f"↻ {Q.dur(wk.reset - now)}"
        text(cr, x + 10 + big, y + 38, sub, 12, "dim")
        pace = wk.pace(now) if r.back == 0 else None
        if pace is not None:
            text(cr, x + 10 + big, y + 52, f"pace {pace:+.0f} pts", 12,
                 "warn" if pace > 10 else ("ok" if pace > -15 else "pace"))
    else:
        text(cr, x + 4, y + 34, "?%", 26, "dim", bold=True)
        if wk is not None:
            text(cr, x + 50, y + 44, f"reset {Q.when(wk.reset, now)}", 12, "dim")
    text(cr, x + 4, y + 68, r.verdict, 13, r.tone if r.tone != "dim" else "dim", bold=r.tone == "hit")

    # 5h meter.
    my = y + h - 6
    mw = 120
    cr.rectangle(x + 4, my, mw, 5)
    cr.set_source_rgba(*rgba("alt"))
    cr.fill()
    if r.five_live:
        cr.rectangle(x + 4, my, mw * min(100.0, r.u5) / 100, 5)
        cr.set_source_rgba(*rgba(r.five_colour() if r.five_colour() != "fg" else "pace"))
        cr.fill()
    ceiling = Q.CEILING[r.pool]
    cr.rectangle(x + 4 + mw * ceiling / 100, my - 2, 1, 9)
    cr.set_source_rgba(*rgba("warn", 0.7))
    cr.fill()
    five = f"5h {r.u5:.0f}% ↻ {Q.dur(r.r5)}" if r.five_live else "5h idle"
    text(cr, x + mw + 10, my - 6, five, 12, "fg" if r.five_live else "dim")

    # Chart, the 5h peaks under it, the day names under those.
    cx, cw = x + INFO_W, w - INFO_W - 44
    peaks_h, label_h = 12, 13
    chh = h - peaks_h - label_h - 4
    week_chart(cr, cx, y, cw, chh, r, now, detail=True)
    peaks_chart(cr, cx, y + chh + 2, cw, peaks_h, r)
    if wk is None:
        return

    def X(t: float) -> float:
        return cx + (t - wk.start) / Q.WEEK * cw

    def Y(v: float) -> float:
        return y + chh - max(0.0, min(100.0, v)) / 100 * chh

    day = datetime.fromtimestamp(wk.start).replace(hour=0, minute=0, second=0, microsecond=0)
    while day.timestamp() < wk.reset:
        noon = X(day.timestamp() + 43200)
        if cx + 8 < noon < cx + cw - 8:
            text(cr, noon, y + h - label_h + 1, f"{day:%a}", 11, "dim", align=0.5)
        day += timedelta(days=1)
    # Right-hand labels: target, projection, now value — skipped when they would overlap.
    taken: list[float] = []

    def label(v: float, s: str, colour: str) -> None:
        ly = Y(v) - 7
        if any(abs(ly - t) < 11 for t in taken):
            return
        taken.append(ly)
        text(cr, cx + cw + 5, ly, s, 11, colour)

    if not r.over:
        label(wk.used, f"{wk.used:.0f}%", r.colour)
        proj = wk.projected(now) if r.back == 0 else None
        if proj is not None:
            label(proj, f"~{proj:.0f}%", r.colour)
    label(Q.TARGET, f"{Q.TARGET:.0f}%", "pace")


# ── the deck window ──────────────────────────────────────────────────────────


def model():
    """qtop's model, with Store.weeks cached until the log grows.

    weeks() rebuilds every week from the whole log, and a deck draw asks for it twice
    per account (the cards and the pool totals): two thirds of the draw time."""
    m = Q.Model(Q.Store(Q.CSV))
    store, raw, cache = m.store, m.store.weeks, {}

    def weeks(account: str):
        key = (account, store.offset)
        if key not in cache:
            for old in [k for k in cache if k[1] != store.offset]:
                del cache[old]
            cache[key] = raw(account)
        return cache[key]

    store.weeks = weeks
    return m


class Deck:
    """The drop-down: a transparent overlay over the output below the bar, the deck drawn
    on it under the strip.

    In the daemon it is resident: the window is built once and hidden, and the deck is
    drawn ahead of time whenever the data changes (draw_deck takes ~0.15 s; a cold
    `quota-deck deck` took ~1.5 s, most of it importing GTK and parsing the log).
    Opening it costs one map and one blit, ~20 ms.

    The strip (~/.config/waybar/quota-hover.so) says where the pointer is:
      enter  the pointer rests on the strip: open, without taking the keyboard. It closes
             when the pointer leaves both the strip and the deck. The overlay never
             covers the bar, so the strip keeps seeing the pointer.
      click  pin it open, with the keyboard: it stays until Esc, a click outside it, or
             another click on the strip. A click inside the deck pins it too.
    Without the daemon, `quota-deck deck` builds one of these, pinned, and quits when it
    closes."""

    # The pointer may cross the bar between the strip and the deck, and the strip only
    # says "enter" after resting HOVER_MS (quota-hover.c): wait this long before closing.
    HIDE_GRACE_MS = 150

    def __init__(self, m, resident: bool):
        from gi.repository import Gdk, GLib, Gtk, GtkLayerShell

        self.Gdk, self.GLib, self.Gtk, self.LS = Gdk, GLib, Gtk, GtkLayerShell
        self.m, self.resident = m, resident
        self.back, self.sel, self.origin, self.hits = 0, -1, None, []
        self.cache: dict[tuple, tuple] = {}  # (back, sel, scale) -> (surface, hits)
        self.shown = self.pinned = False
        self.center: float | None = None  # the strip's centre, output coordinates
        self.hide_timer = 0
        self.asked = 0.0  # perf_counter of the last show, for TRACE

        win = self.win = Gtk.Window()
        GtkLayerShell.init_for_window(win)
        GtkLayerShell.set_namespace(win, "quota-deck")
        GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                     GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(win, edge, True)
        GtkLayerShell.set_exclusive_zone(win, 0)  # below the bar: the strip must see the pointer
        GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.NONE)
        visual = win.get_screen().get_rgba_visual()
        if visual is not None:
            win.set_visual(visual)
        win.set_app_paintable(True)
        self.area = Gtk.DrawingArea()
        win.add(self.area)
        self.area.connect("draw", self.on_draw)
        win.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK
                       | Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.BUTTON_PRESS_MASK)
        win.connect("enter-notify-event", self.on_enter)
        win.connect("leave-notify-event", self.on_leave)
        win.connect("motion-notify-event", self.on_motion)
        win.connect("button-press-event", self.on_press)
        win.connect("key-press-event", self.on_key)
        win.connect("delete-event", lambda *_: self.hide() or True)

    # -- drawing ---------------------------------------------------------------

    def scales(self) -> set[int]:
        """The scale factor of every monitor: the deck is drawn ahead for each."""
        display = self.Gdk.Display.get_default()
        return {display.get_monitor(i).get_scale_factor() for i in range(display.get_n_monitors())} or {1}

    def frame(self, scale: int) -> tuple:
        key = (self.back, self.sel, scale)
        if key not in self.cache:
            if TRACE and self.shown:
                print(f"quota-deck: drawing {key} (not drawn ahead)", file=sys.stderr, flush=True)
            w, h = deck_size(len(self.m.accounts()))
            surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, w * scale, h * scale)
            surface.set_device_scale(scale, scale)
            hits = draw_deck(cairo.Context(surface), self.m, time.time(), self.back, self.sel)
            self.cache[key] = (surface, hits)
        return self.cache[key]

    def refresh(self) -> None:
        """New data: redraw the frames an opening will want — the current week, the active
        account selected — and, when open, the one on screen."""
        self.cache.clear()
        if self.shown:
            self.area.queue_draw()
            return
        self.back, self.sel = 0, self.active_index()
        for scale in self.scales():
            self.frame(scale)

    def on_draw(self, _w, cr) -> bool:
        cr.set_source_rgba(0, 0, 0, 0)
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        if not self.shown:
            return False
        surface, self.hits = self.frame(self.win.get_scale_factor())
        dw, _ = deck_size(len(self.m.accounts()))
        width = self.win.get_allocated_width()
        # Centred under the strip, kept on the output; at the right when nobody said where.
        x = (width - dw - 6) if self.center is None else self.center - dw / 2
        self.origin = (int(min(max(x, 6), max(6, width - dw - 6))), 4)
        cr.set_source_surface(surface, *self.origin)
        cr.paint()
        if TRACE and self.asked:
            print(f"quota-deck: drawn {(time.perf_counter() - self.asked) * 1000:.0f} ms after the "
                  f"{'click' if self.pinned else 'hover'}", file=sys.stderr, flush=True)
            self.asked = 0.0
        return False

    # -- showing ---------------------------------------------------------------

    def active_index(self) -> int:
        accts = self.m.accounts()
        active = read_active()
        return accts.index(active) if active in accts else -1

    def monitor_at(self, mx: int, my: int):
        display = self.Gdk.Display.get_default()
        for i in range(display.get_n_monitors()):
            mon = display.get_monitor(i)
            g = mon.get_geometry()
            if (g.x, g.y) == (mx, my):
                return mon
        return None

    def show(self, center: float | None = None, monitor=None, pinned: bool = False) -> None:
        self.cancel_hide()
        if pinned and not self.pinned:
            self.pinned = True
            self.LS.set_keyboard_mode(self.win, self.LS.KeyboardMode.EXCLUSIVE)
        if self.shown:
            return
        sel = self.active_index()
        if (self.back, self.sel) != (0, sel):
            self.back, self.sel = 0, sel
        if center is not None:
            self.center = center
        if monitor is not None:
            self.LS.set_monitor(self.win, monitor)
        self.shown, self.asked = True, time.perf_counter()
        self.win.show_all()

    def hide(self) -> None:
        self.cancel_hide()
        if not self.resident:
            self.Gtk.main_quit()
            return
        if not self.shown:
            return
        self.shown = False
        self.win.hide()
        if self.pinned:
            self.pinned = False
            self.LS.set_keyboard_mode(self.win, self.LS.KeyboardMode.NONE)
        if (self.back, self.sel) != (0, self.active_index()):
            self.GLib.idle_add(lambda: self.refresh() or False)  # have the default frame ready again

    def hide_soon(self) -> None:
        if self.shown and not self.pinned and not self.hide_timer:
            self.hide_timer = self.GLib.timeout_add(self.HIDE_GRACE_MS, self._hide_timeout)

    def _hide_timeout(self) -> bool:
        self.hide_timer = 0
        if not self.pinned:
            self.hide()
        return False

    def cancel_hide(self) -> None:
        if self.hide_timer:
            self.GLib.source_remove(self.hide_timer)
            self.hide_timer = 0

    def message(self, msg: str) -> None:
        """One datagram from the strip (quota-hover.c), or "click" for SIGUSR1."""
        verb, *args = msg.split()
        center = monitor = None
        if len(args) == 3:
            center = float(args[0])
            monitor = self.monitor_at(int(args[1]), int(args[2]))
        if verb == "enter":
            self.show(center, monitor)
        elif verb == "leave":
            self.hide_soon()
        elif verb == "click":
            if self.shown and self.pinned:
                self.hide()
            else:
                self.show(center, monitor, pinned=True)

    # -- input -----------------------------------------------------------------

    def in_deck(self, ex: float, ey: float) -> bool:
        if self.origin is None:
            return False
        ox, oy = self.origin
        dw, dh = deck_size(len(self.m.accounts()))
        return ox <= ex < ox + dw and oy <= ey < oy + dh

    def card_at(self, ex: float, ey: float) -> str | None | bool:
        """The account under (ex, ey); None inside the deck but on no card; False outside."""
        if not self.in_deck(ex, ey):
            return False
        for account, y0, y1 in self.hits:
            if y0 <= ey - self.origin[1] < y1:
                return account
        return None

    def on_enter(self, _w, event) -> bool:
        if self.in_deck(event.x, event.y):
            self.cancel_hide()
        elif not self.pinned:
            self.hide()
        return False

    def on_leave(self, _w, event) -> bool:
        # Up to the bar: maybe back onto the strip, which then says "enter" again.
        if event.detail != self.Gdk.NotifyType.INFERIOR:
            self.hide_soon()
        return False

    def on_motion(self, _w, event) -> bool:
        if self.pinned:
            return False
        if self.in_deck(event.x, event.y):
            self.cancel_hide()
        else:
            self.hide()
        return False

    def open_qtop(self, account: str) -> None:
        subprocess.Popen(["alacritty", "-e", "qtop", account], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.hide()

    def on_press(self, _w, event) -> bool:
        hit = self.card_at(event.x, event.y)
        if hit is False:
            self.hide()
        elif hit:
            self.open_qtop(hit)
        else:
            self.show(pinned=True)
        return True

    def on_key(self, _w, event) -> bool:
        key = self.Gdk.keyval_name(event.keyval) or ""
        ctrl = bool(event.state & self.Gdk.ModifierType.CONTROL_MASK)
        n = len(self.m.accounts())
        if key in ("Escape", "q") or (ctrl and key == "g"):
            self.hide()
            return True
        if key in ("i", "Down") or (ctrl and key == "n"):
            self.sel = (self.sel + 1) % n
        elif key in ("o", "Up") or (ctrl and key == "p"):
            self.sel = (self.sel - 1) % n
        elif key in ("u", "Left") or (ctrl and key == "b"):
            self.back += 1
        elif key in ("p", "Right") or (ctrl and key == "f"):
            self.back = max(0, self.back - 1)
        elif key == "r":
            self.m.sample()
            self.cache.clear()
        elif key in ("Return", "KP_Enter") and 0 <= self.sel < n:
            self.open_qtop(self.m.accounts()[self.sel])
            return True
        else:
            return False
        self.area.queue_draw()
        return True


def require_gtk() -> None:
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GtkLayerShell", "0.1")


def deck() -> int:
    """The slow path: no daemon to ask (the strip's click tries the daemon first)."""
    require_gtk()
    from gi.repository import Gtk

    lock = open(f"{RUN_DIR}/deck.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0  # one is open already
    m = model()
    m.store.load()
    d = Deck(m, resident=False)
    d.show(pinned=True)
    Gtk.main()
    return 0


# ── the daemon ───────────────────────────────────────────────────────────────


def mtime(path: str) -> float:
    try:
        return os.stat(path).st_mtime
    except OSError:
        return 0.0


def signal_waybar() -> None:
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/comm") as fh:
                if fh.read().strip() != "waybar":
                    continue
            if os.stat(f"/proc/{pid}").st_uid == os.getuid():
                os.kill(int(pid), signal.SIGRTMIN + SIGNAL)
        except OSError:
            continue


def render_all(m, now: float) -> None:
    rs = rows(m, now)
    for mode, scale in (("full", 1), ("compact", 2)):
        draw_strip(f"{RUN_DIR}/{mode}.png", rs, now, mode, scale)


def daemon() -> int:
    # Die with waybar (it starts us as a custom module), and only one renderer: both
    # bars start one, the second waits on the lock and takes over if the first dies.
    libc = ctypes.CDLL("libc.so.6")
    libc.prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG
    lock = open(f"{RUN_DIR}/daemon.lock", "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    # Named only once it holds the lock: the strip's click is `pkill -USR1 -x quota-deck`,
    # and SIGUSR1 would kill a daemon still waiting on the lock (default action).
    libc.prctl(15, b"quota-deck", 0, 0, 0)  # PR_SET_NAME
    require_gtk()
    from gi.repository import GLib, Gtk

    m = model()
    d = Deck(m, resident=True)
    # Toggle from an idle callback at default priority, never straight from a
    # high-priority source: GDK starts a Wayland read in its source's prepare step, a
    # higher-priority dispatch skips the check step that finishes it, and the
    # layer-shell map then waits in a roundtrip for that read for ever (seen: the
    # first click froze the daemon inside show_all).
    def on_usr1() -> bool:
        GLib.idle_add(lambda: d.message("click") or False)
        return True

    # The strip's messages (quota-hover.c). Same rule as SIGUSR1: act from an idle callback.
    ctl = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    ctl_path = f"{RUN_DIR}/ctl"
    with contextlib.suppress(FileNotFoundError):
        os.unlink(ctl_path)
    ctl.bind(ctl_path)
    ctl.setblocking(False)

    def on_ctl(*_args) -> bool:
        while True:
            try:
                msg = ctl.recv(256).decode(errors="replace")
            except BlockingIOError:
                return True
            GLib.idle_add(lambda msg=msg: d.message(msg) or False)

    GLib.io_add_watch(ctl.fileno(), GLib.PRIORITY_DEFAULT, GLib.IOCondition.IN, on_ctl)

    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix

        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, on_usr1)
    except (ImportError, ValueError):  # GLib < 2.84
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, on_usr1)
    seen = [None]

    def tick() -> bool:
        now = time.time()
        # The federation writes every 30 s; the minute makes the "now" line move when it is quiet.
        key = (mtime(Q.CSV), mtime(Q.SNAPSHOT), mtime(ACCOUNT_FILE), int(now // 60))
        if key != seen[0]:
            seen[0] = key
            try:
                m.store.load()
                render_all(m, now)
                signal_waybar()
                d.refresh()
            except Exception as err:  # keep the bar alive across a bad row or a qtop edit
                print(f"quota-deck: {err!r}", file=sys.stderr, flush=True)
        return True

    tick()
    GLib.timeout_add_seconds(2, tick)
    Gtk.main()
    return 0


def main(argv: list[str]) -> int:
    os.makedirs(RUN_DIR, exist_ok=True)
    cmd = argv[1] if len(argv) > 1 else "deck"
    scale = int(argv[argv.index("--scale") + 1]) if "--scale" in argv else 1
    if cmd == "daemon":
        return daemon()
    if cmd == "deck":
        return deck()
    if cmd == "strip" and len(argv) > 2:
        m = model()
        m.store.load()
        now = time.time()
        draw_strip(argv[2], rows(m, now), now, "compact" if "--compact" in argv else "full", scale)
        return 0
    if cmd == "deck-png" and len(argv) > 2:
        m = model()
        m.store.load()
        back = int(argv[argv.index("--back") + 1]) if "--back" in argv else 0
        w, h = deck_size(len(m.accounts()))
        surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, w * scale, h * scale)
        cr = cairo.Context(surface)
        cr.scale(scale, scale)
        draw_deck(cr, m, time.time(), back, 0)
        surface.write_to_png(argv[2])
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
