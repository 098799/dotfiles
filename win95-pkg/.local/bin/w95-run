#!/usr/bin/env python3
"""Open just the Run... dialog, for a Win+R binding."""
import os
import sys

_HERE = os.path.dirname(os.path.realpath(__file__))
for _c in (os.path.expanduser("~/.local/share/w95"),
           os.path.normpath(os.path.join(_HERE, "..", "share", "w95"))):
    if os.path.exists(os.path.join(_c, "w95.css")):
        sys.path.insert(0, _c)
        break
else:
    sys.exit("w95-run: cannot locate w95.css")

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gtk  # noqa: E402

import w95menu  # noqa: E402

css = Gtk.CssProvider()
css.load_from_path(os.path.join(sys.path[0], "w95.css"))
Gtk.StyleContext.add_provider_for_screen(
    Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

dialog = w95menu.RunDialog(css)
dialog.connect("destroy", Gtk.main_quit)
dialog.show_all()
Gtk.main()
