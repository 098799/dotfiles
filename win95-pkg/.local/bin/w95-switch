#!/usr/bin/env bash
# w95-switch — turn the Windows 95 desktop on or off in the running session.
#
#   w95-switch on       swap in i3-95 + Chicago95 + the taskbar
#   w95-switch off      back to stock i3 and your normal theme
#   w95-switch toggle   whichever you are not
#   w95-switch status   what is active, and whether switching is possible
#
# Needs the "i3 (Win95-switchable)" session (see i3-session). Inside it this
# is a plain `i3-msg restart`: windows, workspaces and layout all survive.
set -uo pipefail

PKG="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
BIN="$PKG/.local/bin"
STATE=$HOME/.config/w95/wm
WRAPPER=$(readlink -f "$BIN/i3-session")
I3_95=$HOME/.local/bin/i3-95
CONFIG=$HOME/.config/i3/config
KEYS=$HOME/.config/i3/active-keys.conf

say() { printf '\033[1m%s\033[0m\n' "$*"; }
die() {
    printf 'w95-switch: %s\n' "$*" >&2
    # setsid + all three fds closed: i3-nagbar sits on screen until it is
    # clicked, and a plain `&` leaves it holding our stdout. Anything that
    # calls this script through a pipe — w95-rofi, a keybinding — would then
    # hang forever on the error path instead of reporting it.
    if command -v i3-nagbar >/dev/null && [[ -n ${DISPLAY:-} ]]; then
        setsid -f i3-nagbar -t error -m "w95-switch: $*" \
            >/dev/null 2>&1 </dev/null
    fi
    exit 1
}

# Are we running under i3-session? i3 keeps its own argv, so ask the process.
# The name to match on is 'i3-95' as well as 'i3': `exec -a` rewrites argv[0]
# but the kernel still takes comm from the basename of the binary it loaded,
# so the running WM is called i3-95 exactly when the Win95 one is active.
wm_pid() { pgrep -x -U "$UID" 'i3|i3-95' | head -1; }

under_wrapper() {
    local pid argv0
    pid=$(wm_pid)
    [[ -n $pid ]] || return 1
    argv0=$(tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null | head -1)
    [[ $(readlink -f "$argv0" 2>/dev/null) == "$WRAPPER" ]]
}

current() { cat "$STATE" 2>/dev/null || echo stock; }

# Everything that must be true before we hand the session to a different
# binary. Checked *before* any state is written, so a failure is a no-op.
preflight() {
    [[ -x $I3_95 ]] || die "i3-95 is not built — run: w95 wm install"
    under_wrapper ||
        die "this session was not started by i3-session; log out and pick the \"i3 (Win95-switchable)\" session first"
    # The Win95 keybindings are deliberately NOT installed: 10+ years of i3
    # muscle memory beats period accuracy, and this desktop is not worth one
    # relearned chord. active-keys.conf stays pointed at no-keys.conf.
    # The config is still validated under i3-95 before we hand it the session.
    if ! "$I3_95" -C -c "$CONFIG" >/dev/null 2>&1; then
        printf '\n' >&2
        "$I3_95" -C -c "$CONFIG" 2>&1 | grep -i "ERROR" | head -5 >&2
        die "your i3 config does not parse under i3-95 — nothing changed"
    fi
}

restart_i3() {
    i3-msg -q restart || die "i3 refused to restart"
    # Wait for the new process to answer before touching anything else.
    for _ in $(seq 40); do
        i3-msg -t get_version >/dev/null 2>&1 && return 0
        sleep 0.25
    done
    return 0
}

cmd_on() {
    preflight
    say "applying Windows 95 assets, palette and GTK settings"
    # Through `theme`, not `w95` directly: `w95 on` dresses the desktop, but
    # dunst, rofi, tmux, fzf and bat are generated from the semantic palette
    # and only `theme` knows how to do that. Calling w95 alone left the Start
    # menu and every notification in gruvbox.
    if [[ -x $HOME/bin/theme ]]; then
        W95_NO_SWITCH=1 "$HOME/bin/theme" light win95 >/dev/null || die "theme light win95 failed"
    else
        "$BIN/w95" on >/dev/null || die "w95 on failed"
    fi
    mkdir -p "$(dirname "$STATE")"
    printf 'w95\n' >"$STATE"
    say "restarting i3 into i3-95 (layout is preserved)"
    restart_i3
    pkill -f "bin/w95bar" 2>/dev/null
    setsid -f "$BIN/w95bar" >"$HOME/.local/state/w95/bar.log" 2>&1 </dev/null
    say "Windows 95 is up. \`w95-switch off\` to go back."
}

cmd_off() {
    printf 'stock\n' >"$STATE"
    pkill -f "bin/w95bar" 2>/dev/null
    # Repaint everything back to whatever we were on before Windows 95, which
    # `theme` stashed in prew95 on the way in. This also runs `w95 off`.
    prev=$(cat "$HOME/.config/theme/prew95" 2>/dev/null || echo "dark gruvbox")
    if [[ -x $HOME/bin/theme ]]; then
        W95_NO_SWITCH=1 "$HOME/bin/theme" $prev >/dev/null 2>&1 || true
    else
        "$BIN/w95" off >/dev/null 2>&1
    fi
    say "restarting i3 into stock i3"
    restart_i3
    say "back to normal."
}

case "${1:-status}" in
on) cmd_on ;;
off) cmd_off ;;
toggle) [[ $(current) == w95 ]] && cmd_off || cmd_on ;;
status)
    printf 'state    : %s\n' "$(current)"
    # The binary actually serving the session, not whatever `i3` resolves to.
    printf 'running  : %s\n' \
        "$(readlink -f "/proc/$(wm_pid)/exe" 2>/dev/null || echo 'no window manager found')"
    printf 'i3-95    : %s\n' "$([[ -x $I3_95 ]] && echo built || echo 'not built (w95 wm install)')"
    printf 'keys     : %s\n' "$(basename "$(readlink -f "$KEYS" 2>/dev/null)" 2>/dev/null || echo none)"
    printf 'taskbar  : %s\n' "$(pgrep -f 'bin/w95bar' >/dev/null && echo running || echo stopped)"
    printf 'switchable: %s\n' "$(under_wrapper && echo yes || echo 'no — not in the i3-session wrapper')"
    ;;
*) sed -n '2,10p' "$(readlink -f "$0")" | sed 's/^# \?//'; exit 1 ;;
esac
