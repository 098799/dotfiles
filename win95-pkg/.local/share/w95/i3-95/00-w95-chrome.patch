diff --git a/src/click.c b/src/click.c
index f3388db..32f6c14 100644
--- a/src/click.c
+++ b/src/click.c
@@ -8,6 +8,7 @@
  *
  */
 #include "all.h"
+#include "w95.h"
 
 #include <time.h>
 
@@ -180,6 +181,40 @@ static void route_click(Con *con, xcb_button_press_event_t *event, const click_d
         return;
     }
 
+    /* i3-95: a left click on one of the caption's control buttons acts on the
+     * window instead of falling through to focus/drag. Checked before user
+     * bindings so [X] stays [X] no matter what else is bound to button 1.
+     * Only the press is acted on; the matching release is swallowed below so
+     * it can't reach a window that no longer exists. */
+    if (dest == CLICK_DECORATION && event->detail == XCB_BUTTON_CLICK_LEFT) {
+        const w95_button_t hit = w95_button_at(con, event->event_x, event->event_y);
+        if (hit != W95_BTN_NONE) {
+            if (event->response_type == XCB_BUTTON_PRESS) {
+                switch (hit) {
+                    case W95_BTN_MINIMIZE:
+                        /* i3 has no iconify; the scratchpad is the closest
+                         * thing, and w95bar lists scratchpad windows greyed
+                         * out so they can be restored from the taskbar. */
+                        con_focus(con);
+                        scratchpad_move(con);
+                        break;
+                    case W95_BTN_MAXIMIZE:
+                        con_toggle_fullscreen(con, CF_OUTPUT);
+                        break;
+                    case W95_BTN_CLOSE:
+                        tree_close_internal(con, KILL_WINDOW, false);
+                        break;
+                    default:
+                        break;
+                }
+                tree_render();
+            }
+            xcb_allow_events(conn, XCB_ALLOW_ASYNC_POINTER, event->time);
+            xcb_flush(conn);
+            return;
+        }
+    }
+
     /* if the user has bound an action to this click, it should override the
      * default behavior. */
     Binding *bind = get_binding_from_xcb_event((xcb_generic_event_t *)event);
